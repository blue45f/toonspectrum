# ToonSpectrum voluntary operating-cost support via Toss Payments.
# Start with matching TEST keys. Test payments never charge real money.
SUPPORTER_PAYMENTS_ENABLED=false
TOSS_PAYMENTS_CLIENT_KEY=
TOSS_PAYMENTS_SECRET_KEY=
TOSS_PAYMENTS_API_BASE_URL=https://api.tosspayments.com

# Live payments remain fail-closed unless all settings below are explicit.
PRODUCTION_INTEGRATION_COST_POLICY=zero-cost-only
PRODUCTION_TOSS_ALLOW_LIVE=false

# Creator monetary payouts are a separate fail-closed capability.
# Keep disabled until payout contract, KYC/guardian checks, and payout integration are approved.
CREATOR_SUPPORT_PAYOUTS_ENABLED=false
TOSS_PAYOUTS_SECURITY_KEY=

# Activation checklist:
# 1) apply migrations 0071 and 0072
# 2) configure Toss webhook to /api/supporter-payments/webhooks/toss
# 3) use a matching client/secret key pair
# 4) review merchant/refund/tax disclosures
# 5) explicitly enable live payments only after production approval
