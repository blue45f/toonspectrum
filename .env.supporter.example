# ToonSpectrum voluntary operating-cost support via Toss Payments.
# Start with matching TEST keys. Test payments never charge real money.
SUPPORTER_PAYMENTS_ENABLED=false
# Marketplace commerce shares the Toss merchant key pair but has an independent kill switch.
COMMERCE_PAYMENTS_ENABLED=false
COMMERCE_MOCK_PAYMENTS_ENABLED=false
TOSS_PAYMENTS_CLIENT_KEY=
TOSS_PAYMENTS_SECRET_KEY=
TOSS_PAYMENTS_API_BASE_URL=https://api.tosspayments.com

# Live payments remain fail-closed unless BOTH settings below are explicit.
PRODUCTION_INTEGRATION_COST_POLICY=zero-cost-only
PRODUCTION_TOSS_ALLOW_LIVE=false

# Production activation checklist:
# 1) apply migration 0069, 2) configure Toss webhook to /api/supporter-payments/webhooks/toss,
# 3) use a matching client/secret key pair, 4) review merchant/refund/tax disclosures,
# 5) change cost policy to explicit-cost-enabled, allow live, then enable supporter payments.
