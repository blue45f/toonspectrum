{
  "version": "toonspectrum.free-infrastructure.v3",
  "mode": "free-strict",
  "automaticDeployments": false,
  "automaticPaidFailover": false,
  "defaultProjectStorage": "local-or-byos",
  "forbiddenProviders": [
    "oracle",
    "oci",
    "vercel"
  ],
  "quotaThresholds": {
    "warn": 0.6,
    "forecast": 0.7,
    "redirectNewLargeWrites": 0.8,
    "stopCentralPersonalWrites": 0.85,
    "critical": 0.95
  },
  "authorities": {
    "staticWeb": "cloudflare-static-assets",
    "edgeGateway": "cloudflare-workers",
    "edgeConfiguration": "cloudflare-kv",
    "edgeRelationalIndex": "cloudflare-d1",
    "transactionalDatabase": "cockroachdb-basic",
    "derivedReadModels": "turso-libsql",
    "socialDatabase": "tidb-community",
    "playgroundDatabase": "supabase-playground",
    "realtimeCoordination": "cloudflare-durable-objects",
    "eventDelivery": "cloudflare-queues",
    "publicAssets": "cloudflare-r2",
    "thumbnailDelivery": "imagekit",
    "backupArchive": "backblaze-b2",
    "localProjects": "local-opfs",
    "userOwnedProjects": "user-owned-storage",
    "email": "resend",
    "batchCompute": "local-m2-runner",
    "legacyCompute": "cloud-run-compatibility",
    "identityDatabase": "tidb-identity",
    "projectDatabase": "tidb-projects",
    "commerceDatabase": "tidb-commerce",
    "communityDatabase": "tidb-community",
    "collaborationDatabase": "tidb-collaboration",
    "documentDatabase": "azure-cosmos-free",
    "auditDatabase": "aws-dynamodb-free",
    "notificationDatabase": "firestore-free",
    "presenceDatabase": "firebase-rtdb-free",
    "aiJobDatabase": "mongodb-atlas-m0",
    "liveReviewDatabase": "convex-free",
    "feedbackDatabase": "appwrite-free",
    "analyticsDatabase": "bigquery-sandbox",
    "adHocAnalytics": "motherduck-lite",
    "legacyDatabase": "neon-postgres",
    "analyticsIngestDatabase": "cloudflare-d1"
  },
  "providers": {
    "cloudflare-static-assets": {
      "roles": [
        "static-web",
        "public-catalog-read",
        "edge-config-read",
        "public-assets-read",
        "thumbnail-read",
        "release-artifacts"
