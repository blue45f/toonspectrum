# Server-only template. Not loaded automatically; no production settings are changed.
# Existing local fortune experiences work with every provider disabled.
FORTUNE_KASI_ENABLED=false
# Public Data Portal decoded service key; never use a VITE_ prefix.
FORTUNE_KASI_SERVICE_KEY=

# Require a recorded commercial display/cache approval before enabling.
# This approval does NOT grant translation, adaptation or sharing rights.
FORTUNE_HOROSCOPE_ENABLED=false
FORTUNE_HOROSCOPE_DISPLAY_AND_CACHE_APPROVED=false
FORTUNE_HOROSCOPE_POLICY_REVISION=

# Per provider / Redis-selected UTC day; reconcile with actual account quotas.
# Existing Upstash coordination configuration is also required.
# No operator AI keys, automatic paid fallback, or paid plan changes.
FORTUNE_PROVIDER_DAILY_REQUEST_LIMIT=100

# KASI special dates require separate portal application/approval.
# Decoded server key; not inherited from the lunar-calendar key.
FORTUNE_KASI_SPECIAL_DAYS_ENABLED=false
FORTUNE_KASI_SPECIAL_SERVICE_KEY=

# Apply reviewed migration 0081 + managed runtime ACL before enabling.
# Uses the existing DATABASE_URL/pool; never creates a database or table at boot.
FORTUNE_SHARED_SNAPSHOTS_ENABLED=false

# Optional process-local warm-up with per-dataset distributed leases.
# Requires shared snapshots; 30s after startup, then 01:15 Asia/Seoul.
# At most six public datasets (current/next month calendar, holidays, solar terms).
# Unexpired snapshots are reused. No horoscope prefetch or paid fallback.
FORTUNE_REFRESH_ENABLED=false

# Optional retention-only mode; requires shared snapshots, but no external provider/key.
# Existing refresh also runs bounded retention before collecting data, even on provider failure.
# Off by default; enabling incurs database usage and needs an explicit operations decision.
FORTUNE_MAINTENANCE_ENABLED=false
