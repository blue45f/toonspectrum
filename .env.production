# Public browser configuration only. Never put credentials in this file.
# The existing same-origin /socket.io gateway forwards to the Render Core API.
# This is an explicit verified gateway, not a guessed static-site WebSocket endpoint.
VITE_STUDIO_LIVE_ORIGIN=https://www.toonstudio.cloud
# Unsaved-room presence/signaling uses the separate, already-deployed Worker protocol.
VITE_STUDIO_REALTIME_ORIGIN=https://realtime.toonstudio.cloud
VITE_STUDIO_REALTIME_PROVIDER_ID=cloudflare-realtime-v1
