# Product documentation is not served by the Vite application. Keep the
# reviewed OpenCascade LGPL boundary because the postbuild notice generator
# validates and embeds it in the deployed legal notices.
docs/*
!docs/third-party
docs/third-party/*
!docs/third-party/opencascade-lgpl.md
/README.md
/PRODUCT.md
/DESIGN.md

# Local QA captures and repository automation metadata.
artifacts/
.github/
.grok/
.claude/
.impeccable/
tmp/
scratch/
.playwright-mcp/

# Cargo build trees and local rust targets are never Vercel build inputs;
# only sealed pkg/pkg-gpu WASM outputs under crates/ are required.
crates/**/target/

# These stacks are deployed independently from the Vercel application.
# The shared realtime protocol/ticket sources remain build inputs for the
# browser adapter and NestJS API, so preserve the Worker's source directory.
deploy/cloudflare-realtime/*
!deploy/cloudflare-realtime/src
!deploy/cloudflare-realtime/src/**
deploy/coturn/
deploy/oci/

# Test-only sources are verified in CI and are not production build inputs.
**/*.test.*
**/*.spec.*
**/__tests__/
**/test/
**/tests/
**/spec/
**/specs/
e2e/
tests/benchmarks/

# The API build explicitly runs this dependency-free Node contract test before
# compilation. Preserve that build input; do not drop the runtime import guard.
!scripts/verify-api-runtime-imports.test.mjs
