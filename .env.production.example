# ── ToonSpectrum 프로덕션 환경변수 템플릿 ──
# 기본 배포는 무료 우선 분리 구조입니다.
# - 정적 웹·카탈로그: Cloudflare Static Assets(dist/)
# - 동적 API: 검토된 별도 Core API origin
# - 실시간 room 조정: Cloudflare Durable Objects
# - 개인 프로젝트: OPFS/로컬/BYOS 우선
# Vercel은 전환 기간의 수동 비상 fallback이며 Git 자동 배포는 사용하지 않습니다.

# ===== Core API / 호환 런타임 환경변수 =====

# 호스트 플랫폼이 자동 주입하는 런타임 값. 자체 호스트에서는 동일 계약을 명시하세요.
# NODE_ENV=production
# API_RUNTIME_ROLE=full       # Render 실시간 전용 호스트는 studio-live
# PORT=                      # 플랫폼 할당 포트를 우선 사용하며 고정하지 않습니다.

# [필수] PostgreSQL 연결 문자열(Neon 또는 호환 Postgres, sslmode=verify-full).
# 동적 기능(리뷰·인증·커뮤니티·관리자)과 ingest/API 폴백 경로에서 사용합니다.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/webdex?sslmode=verify-full

# 인증 요청 제어 경계
# 운영에서는 topology를 반드시 명시합니다. 일반 배포는 distributed를 사용하고,
# 정말 단일 프로세스인 운영만 위험을 수용하는 single-instance-local을 선택합니다.
AUTH_RATE_LIMIT_MODE=distributed
# 개발 호환용 레거시 스위치. 운영에서는 비워 두고 위 canonical mode만 사용합니다.
AUTH_DISTRIBUTED_RATE_LIMIT_ENABLED=
# distributed 인증 제한의 전역 카운터. 아래 URL/token/hash secret은 배포 secret store에
# 실제 값을 설정해야 하며, 빈 값이면 API bootstrap/readiness가 의도적으로 실패합니다.
UPSTASH_COORDINATION_ENABLED=true
UPSTASH_COORDINATION_REST_URL=
UPSTASH_COORDINATION_REST_TOKEN=
UPSTASH_COORDINATION_KEY_HASH_SECRET=
UPSTASH_COORDINATION_NAMESPACE=toonspectrum-production

# 운영 ingress가 고정 IP/Trusted proxy 경계를 제공할 때만 true로 설정.
# AUTH_TRUSTED_PROXY_ENABLED=true
# AUTH_TRUSTED_PROXY_IPS에 ingress hop의 exact IP를 쉼표로 나열(CIDR 미지원).
# AUTH_TRUSTED_CLIENT_IP_HEADER= x-forwarded-for | x-real-ip | x-vercel-forwarded-for | cf-connecting-ip
# AUTH_TRUSTED_PROXY_MAX_FORWARDED_HOPS=8
AUTH_TRUSTED_PROXY_ENABLED=
AUTH_TRUSTED_PROXY_IPS=
AUTH_TRUSTED_CLIENT_IP_HEADER=
AUTH_TRUSTED_PROXY_MAX_FORWARDED_HOPS=

# 창작 스튜디오 실시간 클러스터 adapter는 WebSocket을 유지하는 장기 실행 Nest 배포에서만 사용합니다.
# serverless 호환 런타임에서는 memory를 유지하며 adapter를 장착하지 않습니다. Render/Fly 등
# 검토된 다중 Nest 인스턴스에서는 아래 세 값을 별도로 설정하세요. URL은 LISTEN 가능한 direct endpoint여야
# 하며 `-pooler`/PgBouncer transaction endpoint는 부팅 사전검사에서 거부됩니다.
# STUDIO_LIVE_CLUSTER_ADAPTER=postgres
# query는 sslmode/channel_binding만 중복 없이 허용하며 인증서·호스트 검증을 위해 verify-full을 권장합니다.
# STUDIO_LIVE_POSTGRES_URL=postgresql://USER:PASSWORD@DIRECT_HOST/webdex?sslmode=verify-full&channel_binding=require
# STUDIO_LIVE_POSTGRES_POOL_MAX=2
# 모든 장기 실행 API 노드가 inline binary 메타데이터를 해석하는 버전으로 교체된 뒤에만 true.
# STUDIO_LIVE_POSTGRES_INLINE_BINARY_ENABLED=false
# Vercel SPA가 위 장기 실행 Nest Socket.IO 서버를 찾도록 프런트 빌드에 정확한 공개 origin을 넣습니다.
# 미설정 시 정적/Vercel origin을 추측하지 않고 로컬 전용 모드로 닫힙니다. 운영 협업을 활성화하려면
# 반드시 장기 실행 Socket.IO 배포의 origin을 명시하세요.
# VITE_STUDIO_LIVE_ORIGIN=https://realtime.example.com
#
# 각 workload의 동등 기능 공급자 순서·예산·회로 차단기는
# deploy/backend-capabilities.env.example을 기준으로 Vercel secret store에 주입합니다.
# QStash의 gateway AUTH_TOKEN과 paid publish token은 서로 다른 무작위 비밀을 사용합니다.

# Vercel 빌드에 공개되는 Cloudflare Worker의 정확한 HTTPS origin입니다. 설정된 경우에만
# presence·댓글 갱신 알림·화면공유 signaling을 분리하며 실패 시 기존 transport로 폴백합니다.
# Until `toonstudio.cloud` is delegated to the same Cloudflare account, use
# the deployed Worker origin directly. Move to `https://realtime.toonstudio.cloud`
# only after its custom-domain DNS/TLS canary passes.
# VITE_STUDIO_REALTIME_ORIGIN=https://toonspectrum-realtime.toonstudio-realtime.workers.dev
# VITE_STUDIO_REALTIME_PROVIDER_ID=cloudflare-realtime-v1

# Cloudflare Durable Objects가 presence·댓글·화면 공유 시그널링을 담당할 때만 true로
# 활성화합니다. 활성 상태에서 일부 값이 없으면 Nest API는 fail-closed로 부팅을 거부합니다.
STUDIO_REALTIME_TICKET_ENABLED=false
STUDIO_REALTIME_CLOUDFLARE_PROVIDER_ID=cloudflare-realtime-v1
STUDIO_REALTIME_CLOUDFLARE_TICKET_ISSUER=toonspectrum-api
STUDIO_REALTIME_CLOUDFLARE_TICKET_AUDIENCE=toonspectrum-realtime
# Worker secret REALTIME_TICKET_SECRET과 정확히 같은 서버 전용 무작위 값(32바이트 이상).
# Vercel/Nest secret store와 `wrangler secret put`으로 각각 주입하고 파일에는 커밋하지 않습니다.
STUDIO_REALTIME_CLOUDFLARE_TICKET_SECRET=
STUDIO_REALTIME_CLOUDFLARE_TICKET_TTL_SECONDS=120
STUDIO_REALTIME_CLOUDFLARE_SESSION_TTL_SECONDS=300
# 기존 연결의 즉시 session/room ACL 폐기 전달. ticket secret과 분리한 값을 사용하며,
# URL은 query 없이 정확히 /v1/control/revocations에서 끝나야 합니다.
STUDIO_REALTIME_REVOCATION_ENABLED=false
STUDIO_REALTIME_CLOUDFLARE_CONTROL_URL=https://toonspectrum-realtime.toonstudio-realtime.workers.dev/v1/control/revocations
STUDIO_REALTIME_CLOUDFLARE_CONTROL_SECRET=
STUDIO_REALTIME_CLOUDFLARE_CONTROL_TIMEOUT_MS=3000

# 비공개 object storage는 source·derived·export 목적별로 공급자를 고정 라우팅합니다.
# 기존 운영이 Supabase 전용이면 PRIVATE_OBJECT_STORAGE_ENABLED를 비워 둔 채 아래 legacy
# Supabase 설정을 유지합니다. true로 전환하면 선택된 모든 공급자의 구성과 라우팅 fingerprint가
# 정확해야 하며, 하나라도 빠지면 API가 fail-closed로 부팅/ready를 거부합니다.
PRIVATE_OBJECT_STORAGE_ENABLED=
PRIVATE_OBJECT_STORAGE_SOURCE_PROVIDER=
PRIVATE_OBJECT_STORAGE_DERIVED_PROVIDER=
PRIVATE_OBJECT_STORAGE_EXPORT_PROVIDER=
PRIVATE_OBJECT_STORAGE_ROUTING_FINGERPRINT=
# fingerprint 생성 예시:
# pnpm run infra:storage-routing-fingerprint -- --source=cloudflare-r2 --derived=supabase --export=backblaze-b2
#
# 중요: 현재 저장 참조의 v1 wire contract에는 provider id가 포함되지 않습니다. 첫 운영 write 이후
# 라우팅을 바꾸려면 객체 복사 → 크기/SHA-256 검증 → 원장/라우팅 동시 전환 → canary 순서의
# 승인된 migration이 먼저 필요합니다. fingerprint 변경만으로 기존 객체가 이동하지 않습니다.
#
# 선택형 무료 한도 admission. 활성화하면 모든 선택 공급자에 대해 아래 단일행 JSON의 최신
# capacity/usage/forecast/health 스냅샷이 필요합니다. observedAtEpochMs + staleAfterMs가 지난
# 스냅샷은 새 업로드를 fail-closed로 거부하며 기존 읽기·내보내기는 유지합니다.
PRIVATE_OBJECT_STORAGE_QUOTA_GUARD_ENABLED=false
PRIVATE_OBJECT_STORAGE_QUOTA_SNAPSHOTS_JSON=
# JSON version: toonspectrum.private-object-storage-quota.v1
# providers.<id>: capacityBytes, applicationHardCapRatio, billingBoundary,
# health, usedBytes, forecastBytes, observedAtEpochMs, staleAfterMs

# Legacy 및 선택형 Supabase private Storage. 선택한 purpose bucket만 실제 요청되지만, Supabase
# 호환 모드에서는 세 bucket을 모두 private으로 생성합니다. service-role key는 서버에만 둡니다.
SUPABASE_OBJECT_STORAGE_ENABLED=false
SUPABASE_OBJECT_STORAGE_URL=https://PROJECT_REF.supabase.co
SUPABASE_OBJECT_STORAGE_SERVICE_ROLE_KEY=
SUPABASE_OBJECT_STORAGE_SOURCE_BUCKET=studio-source-assets-v1
SUPABASE_OBJECT_STORAGE_DERIVED_BUCKET=studio-derived-assets-v1
SUPABASE_OBJECT_STORAGE_EXPORT_BUCKET=studio-exports-v1
# SUPABASE_OBJECT_STORAGE_TIMEOUT_MS=15000
# SUPABASE_OBJECT_STORAGE_MAXIMUM_ASSET_BYTES=67108864

# Cloudflare R2 S3-compatible private buckets. 라우팅에 선택된 purpose의 bucket만 필수이며
# public access는 사용하지 않습니다. endpoint는 account-level HTTPS origin만 허용합니다.
R2_OBJECT_STORAGE_ENABLED=false
R2_OBJECT_STORAGE_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_OBJECT_STORAGE_REGION=auto
R2_OBJECT_STORAGE_ACCESS_KEY_ID=
R2_OBJECT_STORAGE_SECRET_ACCESS_KEY=
R2_OBJECT_STORAGE_SOURCE_BUCKET=studio-source-r2-v1
# R2_OBJECT_STORAGE_DERIVED_BUCKET=studio-derived-r2-v1
# R2_OBJECT_STORAGE_EXPORT_BUCKET=studio-exports-r2-v1
R2_OBJECT_STORAGE_PRIVATE_BUCKETS_CONFIRMED=false
# R2_OBJECT_STORAGE_TIMEOUT_MS=15000
# R2_OBJECT_STORAGE_MAXIMUM_ASSET_BYTES=67108864
# R2_OBJECT_STORAGE_MAXIMUM_CONTROL_METADATA_BYTES=4096

# Backblaze B2 S3-compatible private buckets. 백업/저빈도 목적을 우선하며 자동 replica는
# 수행하지 않습니다. 라우팅에 선택한 purpose만 이 data plane의 authoritative object가 됩니다.
B2_OBJECT_STORAGE_ENABLED=false
B2_OBJECT_STORAGE_ENDPOINT=https://s3.REGION.backblazeb2.com
B2_OBJECT_STORAGE_REGION=REGION
B2_OBJECT_STORAGE_ACCESS_KEY_ID=
B2_OBJECT_STORAGE_SECRET_ACCESS_KEY=
# B2_OBJECT_STORAGE_SOURCE_BUCKET=studio-source-b2-v1
# B2_OBJECT_STORAGE_DERIVED_BUCKET=studio-derived-b2-v1
B2_OBJECT_STORAGE_EXPORT_BUCKET=studio-exports-b2-v1
B2_OBJECT_STORAGE_PRIVATE_BUCKETS_CONFIRMED=false
# B2_OBJECT_STORAGE_TIMEOUT_MS=15000
# B2_OBJECT_STORAGE_MAXIMUM_ASSET_BYTES=67108864
# B2_OBJECT_STORAGE_MAXIMUM_CONTROL_METADATA_BYTES=4096

# 음성 통화/TURN은 반복 비용이 큰 비핵심 기능이라 기본 배포에서 명시적으로 제외합니다.
# 화면 공유는 WebRTC P2P 미디어 + 작은 신호만 사용하므로 이 스위치와 무관합니다.
STUDIO_LIVE_VOICE_ENABLED=false
# 향후 별도 운영 정책과 TURN data plane을 확정한 배포에서만 아래 값을 활성화하세요.
# STUDIO_VOICE_STUN_URLS=stun:voice.example.com:3478
# STUDIO_VOICE_TURN_URLS=turn:voice.example.com:3478?transport=udp,turn:voice.example.com:3478?transport=tcp,turns:voice.example.com:5349?transport=tcp
# STUDIO_VOICE_TURN_SHARED_SECRET=
# STUDIO_VOICE_TURN_REQUIRED=true
# STUDIO_VOICE_TURN_TTL_SECONDS=900

# 검증된 래스터 CRDT 파일럿은 프런트 빌드 토큰과 장기 실행 Nest 서버의 admission 토큰을 같은
# 릴리스에서 함께 설정해야 합니다. 한쪽만 설정하면 자동 게시/표시가 fail-closed로 비활성화됩니다.
# VITE_STUDIO_RASTER_CRDT_AUTO_PUBLICATION=verified-renderer-handoff-v1
# STUDIO_RASTER_ASSET_ADMISSION=verified-renderer-handoff-v1
# 이미지·VRM·3D 배경 불변 원본 파일럿(공개 rollout 토큰, 비밀 아님).
# STUDIO_WORK_ASSET_ADMISSION=enable-immutable-readonly-work-assets-v1

# OAuth state 서명 키(상용은 고정값 필수).
AUTH_STATE_SECRET=
# 세션 JWT(HS256) 서명 키 — 상용 필수. 미설정 시 토큰 발급이 거부됩니다(약한 폴백 비밀 차단).
#   미설정 시 AUTH_STATE_SECRET 폴백. 강력한 랜덤값 권장(예: openssl rand -base64 48).
AUTH_SESSION_SECRET=

# 정본 도메인과 API 접근을 허용할 운영 프런트 Origin입니다. www는 정본이고 apex는
# Vercel에서 308 리다이렉트하지만, 리다이렉트 전 preflight/Socket.IO upgrade도 허용합니다.
CANONICAL_HOST=www.toonstudio.cloud
API_CORS_ALLOWED_ORIGINS=https://www.toonstudio.cloud,https://toonstudio.cloud

# ── 웹툰 제작 외부 연동(무료 우선·선택) ──
# 기본 정책은 zero-cost-only입니다. 키가 없어도 ICS·Calendar 링크·mailto·백업·CSV·해시 증명이 동작합니다.
PRODUCTION_INTEGRATION_COST_POLICY=zero-cost-only
PRODUCTION_PUBLIC_ORIGIN=https://www.toonstudio.cloud
# PRODUCTION_INTEGRATION_TIMEOUT_MS=15000
# 무료 쿼터 보호용 UTC 일일 상한. 초과 시 유료 fallback 없이 429로 닫힙니다.
# PRODUCTION_DAILY_GOOGLE_CALENDAR_SYNCS=20
# PRODUCTION_DAILY_GMAIL_DRAFTS=100
# PRODUCTION_DAILY_GOOGLE_DRIVE_UPLOADS=50
# PRODUCTION_DAILY_NOTIFICATIONS=200
# PRODUCTION_DAILY_DOCUMENSO_ENVELOPES=20

# Google Workspace 선택 연동. Calendar·Gmail 초안·앱 생성 Drive 파일만 다루는 최소 scope를 요청합니다.
PRODUCTION_GOOGLE_OAUTH_CLIENT_ID=
PRODUCTION_GOOGLE_OAUTH_CLIENT_SECRET=
PRODUCTION_GOOGLE_OAUTH_REDIRECT_URI=https://www.toonstudio.cloud/api/production/integrations/google/callback
PRODUCTION_INTEGRATION_ENCRYPTION_KEY=
# `pnpm integration:generate-secrets` 출력값을 배포 secret store에 저장하세요.
# 표준 Web Push. 세 값이 모두 있어야 활성화됩니다.
PRODUCTION_WEB_PUSH_VAPID_SUBJECT=
PRODUCTION_WEB_PUSH_VAPID_PUBLIC_KEY=
PRODUCTION_WEB_PUSH_VAPID_PRIVATE_KEY=

# 무료 알림 경로. HTTPS URL만 허용하며 미설정 채널은 UI에서 숨깁니다.
PRODUCTION_GENERIC_WEBHOOK_URL=
PRODUCTION_GENERIC_WEBHOOK_SECRET=
PRODUCTION_DISCORD_WEBHOOK_URL=
PRODUCTION_NTFY_BASE_URL=
PRODUCTION_NTFY_TOPIC=
PRODUCTION_NTFY_TOKEN=

# Documenso는 자체 호스팅을 기본 허용하고 hosted API는 명시 승인 전 차단합니다.
DOCUMENSO_BASE_URL=
DOCUMENSO_API_TOKEN=
PRODUCTION_DOCUMENSO_ALLOW_HOSTED=false
# Toss Payments는 test_sk_* 테스트 키만 기본 허용합니다.
# 운영 live 키는 cost policy와 아래 스위치를 모두 명시 변경해야 하며 무료 배포에서는 금지합니다.
TOSS_PAYMENTS_SECRET_KEY=
PRODUCTION_TOSS_ALLOW_LIVE=false

# OAuth 콜백/복귀 베이스 — Vercel 공개 도메인으로 동일하게 설정.
# 콜백 등록 URL(레거시 code-flow 폴백):
# <OAUTH_REDIRECT_BASE_URL>/api/auth/oauth/{google,kakao,naver}/callback
OAUTH_REDIRECT_BASE_URL=https://www.toonstudio.cloud
WEB_APP_BASE_URL=https://www.toonstudio.cloud
WEBDEX_SITE_URL=https://www.toonstudio.cloud

# Google 실연동: GIS(ID 토큰) 흐름이라 CLIENT ID 만 있으면 동작(시크릿 불필요).
#   GCP 콘솔 "승인된 JavaScript 원본"에 WEB_APP_BASE_URL의 정확한 Origin을 등록하세요.
#   미설정 시 Google 로그인만 안전하게 비활성화되고 이메일 로그인은 유지됩니다.
GOOGLE_OAUTH_CLIENT_ID=
# (선택) 레거시 인가-코드 redirect 폴백에서만 사용.
GOOGLE_OAUTH_CLIENT_SECRET=

# Studio 개인 원격 저장소 OAuth. Secret 값은 Vercel/API 런타임 secret store에만 둡니다.
# 각 공급자 콘솔 콜백 URI:
#   https://www.toonstudio.cloud/api/personal-cloud/oauth/google-drive/callback
#   https://www.toonstudio.cloud/api/personal-cloud/oauth/dropbox/callback
#   https://www.toonstudio.cloud/api/personal-cloud/oauth/onedrive/callback
PERSONAL_CLOUD_OAUTH_REDIRECT_BASE_URL=https://www.toonstudio.cloud
# 서로 다른 고정 랜덤값(각각 32바이트 이상). 교체하면 기존 연결 토큰은 재인증이 필요합니다.
PERSONAL_CLOUD_OAUTH_STATE_SECRET=
PERSONAL_CLOUD_TOKEN_ENCRYPTION_KEY=
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
DROPBOX_OAUTH_CLIENT_ID=
DROPBOX_OAUTH_CLIENT_SECRET=
ONEDRIVE_OAUTH_CLIENT_ID=
ONEDRIVE_OAUTH_CLIENT_SECRET=
ONEDRIVE_OAUTH_TENANT=consumers

# 카카오·네이버: 외부 앱키 발급 필요 → 현재 의도적으로 데모 고정(DEMO_ONLY_PROVIDERS).
#   실연동하려면 키를 채우고 lib/server/oauth.ts 의 DEMO_ONLY_PROVIDERS 에서 제거.
# 카카오톡 공유용 공개 JavaScript 키. JavaScript SDK 도메인에는
# https://www.toonstudio.cloud 를 등록하고, REST 키·Client Secret과 혼용하지 않습니다.
VITE_KAKAO_JAVASCRIPT_KEY=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
NAVER_OAUTH_CLIENT_ID=
NAVER_OAUTH_CLIENT_SECRET=

# 관리자 이메일 화이트리스트(선택, 쉼표 구분). 없으면 users.role 로 판단.
ADMIN_EMAILS=

# ── 자동 무료 텍스트 AI 풀 ──
# 키를 VITE_ 변수에 넣지 마세요. 아래 풀은 결제수단이 없거나 결제가 비활성화된 무료 계정만 허용합니다.
# 각 CONFIRMED=true는 해당 계정의 무료 전용 상태를 운영자가 직접 확인했다는 명시적 승인입니다.
# SambaNova는 결제수단이 연결되지 않은 Free Tier, Mistral은 카드 없는 Free mode만 승인합니다.
# Qwen은 China (Beijing) + Free Quota Only, Z.AI와 SiliconFlow는 정확한 무료 모델 allowlist,
# Cloudflare는 Workers Free 플랜 + 무료 플랜 allowlist만 승인합니다.
# 풀은 Gemini → Qwen → Groq → SambaNova → Z.AI → Mistral → Cloudflare → OpenRouter → SiliconFlow 순서입니다.
# 402/429, Qwen AllocationQuota.FreeTierOnly 또는 Cloudflare 403/5035처럼 추론 전 무료 소진이
# 확정된 경우에만 다음 공급자로 이동합니다. 네트워크 오류·타임아웃·5xx에는 중복 호출하지 않습니다.
# 로컬 LLM, 직접 운영 서버, batch API는 이 자동 풀에 포함하지 않습니다.
STUDIO_AI_FREE_POOL_ENABLED=false
# STUDIO_AI_FREE_PROVIDER_ORDER=gemini,qwen,groq,sambanova,zai,mistral,cloudflare,openrouter,siliconflow
STUDIO_AI_FREE_GEMINI_API_KEY=
STUDIO_AI_FREE_GEMINI_CONFIRMED=false
# STUDIO_AI_FREE_GEMINI_MODEL=gemini-3.8-flash
STUDIO_AI_FREE_QWEN_WORKSPACE_ID=
STUDIO_AI_FREE_QWEN_API_KEY=
# true는 China (Beijing) 콘솔에서 Free Quota Only를 활성화한 경우에만 설정합니다.
STUDIO_AI_FREE_QWEN_CONFIRMED=false
# STUDIO_AI_FREE_QWEN_MODEL=qwen3.7-plus
STUDIO_AI_FREE_GROQ_API_KEY=
STUDIO_AI_FREE_GROQ_CONFIRMED=false
# STUDIO_AI_FREE_GROQ_MODEL=openai/gpt-oss-120b
STUDIO_AI_FREE_SAMBANOVA_API_KEY=
# true는 해당 계정에 결제수단이 연결되지 않았음을 확인한 경우에만 설정합니다.
STUDIO_AI_FREE_SAMBANOVA_CONFIRMED=false
# STUDIO_AI_FREE_SAMBANOVA_MODEL=DeepSeek-V3.1
STUDIO_AI_FREE_ZAI_API_KEY=
# true는 GLM-4.7-Flash/GLM-4.5-Flash만 사용하고 유료 도구 호출을 끈 경우에만 설정합니다.
STUDIO_AI_FREE_ZAI_CONFIRMED=false
# STUDIO_AI_FREE_ZAI_MODEL=glm-4.7-flash
STUDIO_AI_FREE_MISTRAL_API_KEY=
# true는 조직이 카드 없는 Free mode이고 Pay-as-you-go가 비활성화된 경우에만 설정합니다.
STUDIO_AI_FREE_MISTRAL_CONFIRMED=false
# STUDIO_AI_FREE_MISTRAL_MODEL=mistral-small-latest
STUDIO_AI_FREE_CLOUDFLARE_ACCOUNT_ID=
STUDIO_AI_FREE_CLOUDFLARE_API_TOKEN=
# true는 Workers Free 플랜이며 유료 전용 모델·AI Gateway 선불 결제를 사용하지 않을 때만 설정합니다.
STUDIO_AI_FREE_CLOUDFLARE_CONFIRMED=false
# 무료 플랜 allowlist만 허용됩니다.
# STUDIO_AI_FREE_CLOUDFLARE_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
STUDIO_AI_FREE_OPENROUTER_API_KEY=
STUDIO_AI_FREE_OPENROUTER_CONFIRMED=false
# 무료 라우터 또는 :free 모델만 허용됩니다.
# STUDIO_AI_FREE_OPENROUTER_MODEL=openrouter/free
STUDIO_AI_FREE_SILICONFLOW_API_KEY=
# true는 중국 리전 가격표상 무료 텍스트 모델만 사용하고 유료 잔액 전환이 없음을 확인한 경우에만 설정합니다.
STUDIO_AI_FREE_SILICONFLOW_CONFIRMED=false
# STUDIO_AI_FREE_SILICONFLOW_MODEL=THUDM/GLM-Z1-9B-0414
# STUDIO_AI_TIMEOUT_MS=45000
# Postgres 기반 사용자별·서비스 전체 UTC 일일 한도. DB 장애 시 호출 전 fail-closed.
# STUDIO_AI_DAILY_REQUEST_LIMIT=200
# STUDIO_AI_DAILY_TOKEN_LIMIT=1000000
# STUDIO_AI_GLOBAL_DAILY_REQUEST_LIMIT=500
# STUDIO_AI_GLOBAL_DAILY_TOKEN_LIMIT=2000000

# 레거시 서버 AI 회귀 테스트 변수. 이전 유료 경로의 마이그레이션 호환용이며,
# STUDIO_AI_FREE_POOL_ENABLED=true인 운영에서는 무시됩니다. 신규 운영 배포에는 설정하지 마세요.
DEEPSEEK_API_KEY=
DEEPSEEK_USER_ID_SALT=
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_TIMEOUT_MS=45000
ZAI_API_KEY=
# ZAI_MODEL=glm-5.1
# ZAI_TIMEOUT_MS=45000
# STUDIO_AI_PROVIDER_ORDER=zai,deepseek
# STUDIO_AI_TIMEOUT_MS=45000
# Postgres 분산 쿼터(UTC 일일 기본 200회 / 1,000,000토큰). DB 장애 시 fail-closed.
# STUDIO_AI_DAILY_REQUEST_LIMIT=200
# STUDIO_AI_DAILY_TOKEN_LIMIT=1000000
# 서비스 전체 비용 상한(모든 사용자 합산, UTC 일일). 미설정 기본값: 500회 / 2,000,000 토큰.
# STUDIO_AI_GLOBAL_DAILY_REQUEST_LIMIT=500
# STUDIO_AI_GLOBAL_DAILY_TOKEN_LIMIT=2000000
# 서버 대납 이미지 에셋 생성(선택, DeepSeek와 별개).
CREATOR_IMAGE_AI_ENABLED=false
OPENAI_API_KEY=
# 운세 콘티 선택형 Gemini 가공기. 미설정/실패 시 결정적 로컬 콘티 사용.
GEMINI_API_KEY=

# 만화규장각 메타데이터 보강(선택). 키는 서버 secret store에만 둡니다.
KMAS_PRV_KEY=
# KMAS_BASE_URL=https://www.kmas.or.kr
# KMAS_MERGE_ON_ACCESS=1
# KMAS_LIVE_SEARCH=0

# 카탈로그는 검토 후 배포 번들에 포함됩니다. 운영 API에는 크롤·갱신 엔드포인트가 없습니다.
# WEBDEX_CATALOG_FILE=apps/api/data/catalog.json.gz

# 표지 이미지 노출 정책(저작권·청소년보호). proxy=허용 호스트 표지 표시(Referer 위조 없음·19+ 항상 비노출),
# off=제3자 표지 전면 비표시(자체 타이포그래픽 커버만, 즉시 킬스위치). 권리침해 신고 대응 시 off 로 전환.
COVER_IMAGE_POLICY=proxy

# 정적 카탈로그 모드가 기본입니다. api로 바꾸면 카탈로그 요청을 Nest API 경로로 보냅니다.
# VITE_CATALOG_SOURCE=static

TZ=Asia/Seoul
