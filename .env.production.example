# ── ToonSpectrum 프로덕션 환경변수 템플릿 ──
# 기본 배포는 Vercel 단일 프로젝트입니다.
# - 프론트: Vite 정적 SPA(dist/)
# - API: /api/* → api/index.js → 컴파일된 NestJS serverless 앱
# - 카탈로그: apps/api/data/catalog.json.gz → public/data/*.json 정적 CDN

# ===== Vercel 프로젝트 환경변수 =====

# Vercel이 자동 주입하는 런타임 값. 다른 호스트에서는 동일 계약을 명시하세요.
# NODE_ENV=production
# API_RUNTIME_ROLE=full       # Render 실시간 전용 호스트는 studio-live
# PORT=                      # 플랫폼 할당 포트를 우선 사용하며 고정하지 않습니다.

# [필수] PostgreSQL 연결 문자열(Neon 또는 호환 Postgres, sslmode=verify-full).
# 동적 기능(리뷰·인증·커뮤니티·관리자)과 ingest/API 폴백 경로에서 사용합니다.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/webdex?sslmode=verify-full

# 인증 요청 제어 경계
# 운영에서는 topology를 반드시 명시합니다. 일반 배포는 distributed를 사용하고,
# 정말 단일 프로세스인 운영만 위험을 수용하는 single-instance-local을 선택합니다.
AUTH_RATE_LIMIT_MODE=distributed
# 개발 호환용 레거시 스위치. 운영에서는 비워 두고 위 canonical mode만 사용합니다.
AUTH_DISTRIBUTED_RATE_LIMIT_ENABLED=
# distributed 인증 제한의 전역 카운터. 아래 URL/token/hash secret은 배포 secret store에
# 실제 값을 설정해야 하며, 빈 값이면 API bootstrap/readiness가 의도적으로 실패합니다.
UPSTASH_COORDINATION_ENABLED=true
UPSTASH_COORDINATION_REST_URL=
UPSTASH_COORDINATION_REST_TOKEN=
UPSTASH_COORDINATION_KEY_HASH_SECRET=
UPSTASH_COORDINATION_NAMESPACE=toonspectrum-production

# 운영 ingress가 고정 IP/Trusted proxy 경계를 제공할 때만 true로 설정.
# AUTH_TRUSTED_PROXY_ENABLED=true
# AUTH_TRUSTED_PROXY_IPS에 ingress hop의 exact IP를 쉼표로 나열(CIDR 미지원).
# AUTH_TRUSTED_CLIENT_IP_HEADER= x-forwarded-for | x-real-ip | x-vercel-forwarded-for | cf-connecting-ip
# AUTH_TRUSTED_PROXY_MAX_FORWARDED_HOPS=8
AUTH_TRUSTED_PROXY_ENABLED=
AUTH_TRUSTED_PROXY_IPS=
AUTH_TRUSTED_CLIENT_IP_HEADER=
AUTH_TRUSTED_PROXY_MAX_FORWARDED_HOPS=

# 창작 스튜디오 실시간 클러스터 adapter는 WebSocket을 유지하는 장기 실행 Nest 배포에서만 사용합니다.
# 이 Vercel serverless 템플릿에서는 memory를 유지하며 adapter를 장착하지 않습니다. OCI/Render/Fly 등
# 다중 Nest 인스턴스에서는 아래 세 값을 별도로 설정하세요. URL은 LISTEN 가능한 direct endpoint여야
# 하며 `-pooler`/PgBouncer transaction endpoint는 부팅 사전검사에서 거부됩니다.
# STUDIO_LIVE_CLUSTER_ADAPTER=postgres
# query는 sslmode/channel_binding만 중복 없이 허용하며 인증서·호스트 검증을 위해 verify-full을 권장합니다.
# STUDIO_LIVE_POSTGRES_URL=postgresql://USER:PASSWORD@DIRECT_HOST/webdex?sslmode=verify-full&channel_binding=require
# STUDIO_LIVE_POSTGRES_POOL_MAX=2
# 모든 장기 실행 API 노드가 inline binary 메타데이터를 해석하는 버전으로 교체된 뒤에만 true.
# STUDIO_LIVE_POSTGRES_INLINE_BINARY_ENABLED=false
# Vercel SPA가 위 장기 실행 Nest Socket.IO 서버를 찾도록 프런트 빌드에 공개 origin을 넣습니다.
# 미설정 시 VITE_API_BASE/runtime API origin, 그마저 없으면 same-origin으로 폴백합니다.
# VITE_STUDIO_LIVE_ORIGIN=https://realtime.example.com
#
# 각 workload의 동등 기능 공급자 순서·예산·회로 차단기는
# deploy/backend-capabilities.env.example을 기준으로 Vercel secret store에 주입합니다.
# QStash의 gateway AUTH_TOKEN과 paid publish token은 서로 다른 무작위 비밀을 사용합니다.

# Vercel 빌드에 공개되는 Cloudflare Worker의 정확한 HTTPS origin입니다. 설정된 경우에만
# presence·댓글 갱신 알림·화면공유 signaling을 분리하며 실패 시 기존 transport로 폴백합니다.
# Until `toonstudio.cloud` is delegated to the same Cloudflare account, use
# the deployed Worker origin directly. Move to `https://realtime.toonstudio.cloud`
# only after its custom-domain DNS/TLS canary passes.
# VITE_STUDIO_REALTIME_ORIGIN=https://toonspectrum-realtime.toonstudio-realtime.workers.dev
# VITE_STUDIO_REALTIME_PROVIDER_ID=cloudflare-realtime-v1

# Cloudflare Durable Objects가 presence·댓글·화면 공유 시그널링을 담당할 때만 true로
# 활성화합니다. 활성 상태에서 일부 값이 없으면 Nest API는 fail-closed로 부팅을 거부합니다.
STUDIO_REALTIME_TICKET_ENABLED=false
STUDIO_REALTIME_CLOUDFLARE_PROVIDER_ID=cloudflare-realtime-v1
STUDIO_REALTIME_CLOUDFLARE_TICKET_ISSUER=toonspectrum-api
STUDIO_REALTIME_CLOUDFLARE_TICKET_AUDIENCE=toonspectrum-realtime
# Worker secret REALTIME_TICKET_SECRET과 정확히 같은 서버 전용 무작위 값(32바이트 이상).
# Vercel/Nest secret store와 `wrangler secret put`으로 각각 주입하고 파일에는 커밋하지 않습니다.
STUDIO_REALTIME_CLOUDFLARE_TICKET_SECRET=
STUDIO_REALTIME_CLOUDFLARE_TICKET_TTL_SECONDS=120
STUDIO_REALTIME_CLOUDFLARE_SESSION_TTL_SECONDS=300
# 기존 연결의 즉시 session/room ACL 폐기 전달. ticket secret과 분리한 값을 사용하며,
# URL은 query 없이 정확히 /v1/control/revocations에서 끝나야 합니다.
STUDIO_REALTIME_REVOCATION_ENABLED=false
STUDIO_REALTIME_CLOUDFLARE_CONTROL_URL=https://toonspectrum-realtime.toonstudio-realtime.workers.dev/v1/control/revocations
STUDIO_REALTIME_CLOUDFLARE_CONTROL_SECRET=
STUDIO_REALTIME_CLOUDFLARE_CONTROL_TIMEOUT_MS=3000

# Supabase Storage는 대용량 원본·파생물·내보내기 결과의 목적별 private data plane입니다.
# 세 bucket은 사전에 생성하고 public=false로 유지하세요. service-role key는 서버에만 둡니다.
SUPABASE_OBJECT_STORAGE_ENABLED=false
SUPABASE_OBJECT_STORAGE_URL=https://PROJECT_REF.supabase.co
SUPABASE_OBJECT_STORAGE_SERVICE_ROLE_KEY=
SUPABASE_OBJECT_STORAGE_SOURCE_BUCKET=studio-source-assets-v1
SUPABASE_OBJECT_STORAGE_DERIVED_BUCKET=studio-derived-assets-v1
SUPABASE_OBJECT_STORAGE_EXPORT_BUCKET=studio-exports-v1
# SUPABASE_OBJECT_STORAGE_TIMEOUT_MS=15000
# SUPABASE_OBJECT_STORAGE_MAXIMUM_ASSET_BYTES=67108864

# 음성 통화/TURN은 반복 비용이 큰 비핵심 기능이라 기본 배포에서 명시적으로 제외합니다.
# 화면 공유는 WebRTC P2P 미디어 + 작은 신호만 사용하므로 이 스위치와 무관합니다.
STUDIO_LIVE_VOICE_ENABLED=false
# 향후 별도 운영 정책과 TURN data plane을 확정한 배포에서만 아래 값을 활성화하세요.
# STUDIO_VOICE_STUN_URLS=stun:voice.example.com:3478
# STUDIO_VOICE_TURN_URLS=turn:voice.example.com:3478?transport=udp,turn:voice.example.com:3478?transport=tcp,turns:voice.example.com:5349?transport=tcp
# STUDIO_VOICE_TURN_SHARED_SECRET=
# STUDIO_VOICE_TURN_REQUIRED=true
# STUDIO_VOICE_TURN_TTL_SECONDS=900

# 검증된 래스터 CRDT 파일럿은 프런트 빌드 토큰과 장기 실행 Nest 서버의 admission 토큰을 같은
# 릴리스에서 함께 설정해야 합니다. 한쪽만 설정하면 자동 게시/표시가 fail-closed로 비활성화됩니다.
# VITE_STUDIO_RASTER_CRDT_AUTO_PUBLICATION=verified-renderer-handoff-v1
# STUDIO_RASTER_ASSET_ADMISSION=verified-renderer-handoff-v1
# 이미지·VRM·3D 배경 불변 원본 파일럿(공개 rollout 토큰, 비밀 아님).
# STUDIO_WORK_ASSET_ADMISSION=enable-immutable-readonly-work-assets-v1

# OAuth state 서명 키(상용은 고정값 필수).
AUTH_STATE_SECRET=
# 세션 JWT(HS256) 서명 키 — 상용 필수. 미설정 시 토큰 발급이 거부됩니다(약한 폴백 비밀 차단).
#   미설정 시 AUTH_STATE_SECRET 폴백. 강력한 랜덤값 권장(예: openssl rand -base64 48).
AUTH_SESSION_SECRET=

# 정본 도메인과 API 접근을 허용할 운영 프런트 Origin입니다. www는 정본이고 apex는
# Vercel에서 308 리다이렉트하지만, 리다이렉트 전 preflight/Socket.IO upgrade도 허용합니다.
CANONICAL_HOST=www.toonstudio.cloud
API_CORS_ALLOWED_ORIGINS=https://www.toonstudio.cloud,https://toonstudio.cloud

# OAuth 콜백/복귀 베이스 — Vercel 공개 도메인으로 동일하게 설정.
# 콜백 등록 URL(레거시 code-flow 폴백):
# <OAUTH_REDIRECT_BASE_URL>/api/auth/oauth/{google,kakao,naver}/callback
OAUTH_REDIRECT_BASE_URL=https://www.toonstudio.cloud
WEB_APP_BASE_URL=https://www.toonstudio.cloud
WEBDEX_SITE_URL=https://www.toonstudio.cloud

# Google 실연동: GIS(ID 토큰) 흐름이라 CLIENT ID 만 있으면 동작(시크릿 불필요).
#   GCP 콘솔 "승인된 JavaScript 원본"에 WEB_APP_BASE_URL의 정확한 Origin을 등록하세요.
#   미설정 시 Google 로그인만 안전하게 비활성화되고 이메일 로그인은 유지됩니다.
GOOGLE_OAUTH_CLIENT_ID=
# (선택) 레거시 인가-코드 redirect 폴백에서만 사용.
GOOGLE_OAUTH_CLIENT_SECRET=
# 카카오·네이버: 외부 앱키 발급 필요 → 현재 의도적으로 데모 고정(DEMO_ONLY_PROVIDERS).
#   실연동하려면 키를 채우고 lib/server/oauth.ts 의 DEMO_ONLY_PROVIDERS 에서 제거.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
NAVER_OAUTH_CLIENT_ID=
NAVER_OAUTH_CLIENT_SECRET=

# 관리자 이메일 화이트리스트(선택, 쉼표 구분). 없으면 users.role 로 판단.
ADMIN_EMAILS=

# 창작 스튜디오 서버 AI(텍스트 전용). 절대 VITE_ 변수로 두지 마세요.
DEEPSEEK_API_KEY=
DEEPSEEK_USER_ID_SALT=
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_TIMEOUT_MS=45000
ZAI_API_KEY=
# ZAI_MODEL=glm-5.1
# ZAI_TIMEOUT_MS=45000
# STUDIO_AI_PROVIDER_ORDER=zai,deepseek
# STUDIO_AI_TIMEOUT_MS=45000
# Postgres 분산 쿼터(UTC 일일 기본 200회 / 1,000,000토큰). DB 장애 시 fail-closed.
# STUDIO_AI_DAILY_REQUEST_LIMIT=200
# STUDIO_AI_DAILY_TOKEN_LIMIT=1000000
# 서비스 전체 비용 상한(모든 사용자 합산, UTC 일일). 미설정 기본값: 500회 / 2,000,000 토큰.
# STUDIO_AI_GLOBAL_DAILY_REQUEST_LIMIT=500
# STUDIO_AI_GLOBAL_DAILY_TOKEN_LIMIT=2000000
# 서버 대납 이미지 에셋 생성(선택, DeepSeek와 별개).
CREATOR_IMAGE_AI_ENABLED=false
OPENAI_API_KEY=
# 운세 콘티 선택형 Gemini 가공기. 미설정/실패 시 결정적 로컬 콘티 사용.
GEMINI_API_KEY=

# 만화규장각 메타데이터 보강(선택). 키는 서버 secret store에만 둡니다.
KMAS_PRV_KEY=
# KMAS_BASE_URL=https://www.kmas.or.kr
# KMAS_MERGE_ON_ACCESS=1
# KMAS_LIVE_SEARCH=0

# 카탈로그 수집은 기본 off. 운영 전 플랫폼별 약관/robots/API 정책/호출량 제한을 검토하세요.
CATALOG_INGEST_MODE=off
CATALOG_INGEST_TRIGGER_TOKEN=
CATALOG_REFRESH_POLL_SECONDS=60

# 표지 이미지 노출 정책(저작권·청소년보호). proxy=허용 호스트 표지 표시(Referer 위조 없음·19+ 항상 비노출),
# off=제3자 표지 전면 비표시(자체 타이포그래픽 커버만, 즉시 킬스위치). 권리침해 신고 대응 시 off 로 전환.
COVER_IMAGE_POLICY=proxy

# 정적 카탈로그 모드가 기본입니다. api로 바꾸면 카탈로그 요청을 Nest API 경로로 보냅니다.
# VITE_CATALOG_SOURCE=static

# 현재 활성 랭킹 경로는 disableLive=true 스냅샷 산식 모드입니다.
# live.ts 어댑터를 별도 운영 경로로 다시 연결하기 전에는 off 유지.
WEBTOON_LIVE_REFRESH_MODE=off

TZ=Asia/Seoul
