# Generate a random value with at least 32 URL-safe characters.
TOONBRIDGE_TOKEN=replace_with_a_random_url_safe_token

# Loopback only. Non-loopback binding is rejected by the server.
TOONBRIDGE_HOST=127.0.0.1
TOONBRIDGE_PORT=49631

# Exact browser origins, comma-separated. Wildcards are not accepted.
TOONBRIDGE_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Job files stay outside the repository by default.
# TOONBRIDGE_DATA_DIR=/absolute/path/to/toonbridge-data
TOONBRIDGE_MAX_ACTIVE_JOBS=2

# Optional exact executable overrides. The service never downloads tools.
# TOONBRIDGE_TOOL_TESSERACT_BIN=/opt/homebrew/bin/tesseract
# TOONBRIDGE_TOOL_FFMPEG_BIN=/opt/homebrew/bin/ffmpeg
# TOONBRIDGE_TOOL_BLENDER_BIN=/Applications/Blender.app/Contents/MacOS/Blender
