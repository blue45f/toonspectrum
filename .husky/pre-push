#!/usr/bin/env sh
# core.hooksPath 는 husky 가 생성하는 .husky/_ 가 아니라 이 디렉터리(.husky)를 가리킨다
# (package.json prepare 가 그렇게 맞춘다). .husky/_ 는 gitignore 대상이라 `pnpm install` 을 한 번도
# 안 돌린 git worktree 에는 없고, 그러면 훅이 통째로 조용히 빠진다 — 2026-09-03 에 그런 워크트리의
# 직접 푸시 네 건이 미검증 코드를 main 에 넣어 하루 동안 core 를 붉게 만들었다. 추적되는 스크립트를
# 직접 실행하면 워크트리마다 설치 상태와 무관하게 같은 게이트가 돈다. HUSKY=0 우회는 애초에 §5 가 막는다.
set -e

# pnpm 이 PATH 에 없을 때(GUI git 클라이언트·비로그인 셸·일부 CI) 자체적으로 PATH 를 보강한다.
# husky 의 머신-로컬 ~/.config/husky/init.sh 가 이미 처리했다면 이 블록은 사실상 no-op 이다.
if ! command -v pnpm >/dev/null 2>&1; then
  # nvm 으로 설치한 node 버전들의 bin (정렬상 마지막=최신이 우선)
  if [ -d "$HOME/.nvm/versions/node" ]; then
    for _d in $(ls -d "$HOME/.nvm/versions/node"/*/bin 2>/dev/null | sort -V); do
      PATH="$_d:$PATH"
    done
  fi
  # corepack/pnpm 의 일반 설치 경로
  PATH="$HOME/Library/pnpm:$HOME/.local/share/pnpm:/opt/homebrew/bin:/usr/local/bin:$PATH"
  export PATH
  # 그래도 없으면 corepack 으로 활성화 시도(corepack 은 node 와 함께 배포됨)
  if ! command -v pnpm >/dev/null 2>&1 && command -v corepack >/dev/null 2>&1; then
    corepack enable pnpm >/dev/null 2>&1 || true
  fi
fi

if ! command -v pnpm >/dev/null 2>&1; then
  echo "pre-push: pnpm 을 찾지 못했습니다. corepack(또는 nvm)으로 pnpm 을 설치하거나," >&2
  echo "          GUI 클라이언트라면 ~/.config/husky/init.sh 에 PATH 를 설정하세요." >&2
  echo "          (검증을 건너뛰고 강제로 푸시하려면: git push --no-verify)" >&2
  exit 127
fi

# 푸시 훅은 "이 푸시가 가져오는 변경"만 본다.
#
# 전에는 여기서 `verify:push`(=`ci` 전체 + 감사 2회 중복)를 돌렸다. 20~45분이 걸렸고,
# 몇 분 뒤 GitHub CI 가 같은 체인을 Postgres 서비스와 Playwright 브라우저까지 갖춘
# 러너에서 다시 돌렸다 — 노트북이 못 하는 검증까지 포함해서. 게다가 `pnpm audit` 이
# 네트워크를 요구해 오프라인에서는 푸시 자체가 불가능했다.
# 무거운 체인은 CI 한 곳에서만 지불하고, 여기서는 빠른 되먹임만 남긴다.
BASE="${PRE_PUSH_BASE:-origin/main}"
git rev-parse --verify --quiet "$BASE" >/dev/null || BASE=""

pnpm run validate:architecture
NODE_OPTIONS='--max-old-space-size=8192' pnpm run typecheck

if [ -n "$BASE" ]; then
  node scripts/lint-changed.mjs "--base=$BASE"
  # 의존성·릴리스 산출물이 이 푸시에 포함될 때만 공급망 검사를 지불한다.
  if git diff --name-only "$BASE...HEAD" -- package.json pnpm-lock.yaml packages/studio-hokusai-wasm \
    | grep -q .; then
    pnpm run audit:security
    pnpm run audit:licenses
  fi
else
  node scripts/lint-changed.mjs
fi
