{
  "name": "@toonspectrum/studio-project-model",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ToonStudio canonical document IR, CommandBus, append-only journal and crash-recovery contracts.",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./node": {
      "types": "./src/node/index.ts",
      "import": "./src/node/index.ts",
      "default": "./src/node/index.ts"
    },
    "./browser": {
      "types": "./src/browser/index.ts",
      "import": "./src/browser/index.ts",
      "default": "./src/browser/index.ts"
    },
    "./work-session": {
      "types": "./src/graph/work-session.ts",
      "import": "./src/graph/work-session.ts",
      "default": "./src/graph/work-session.ts"
    },
    "./work-session-evidence": {
      "types": "./src/graph/work-session-evidence.ts",
      "import": "./src/graph/work-session-evidence.ts",
      "default": "./src/graph/work-session-evidence.ts"
    },
    "./world-publication": {
      "types": "./src/graph/world-publication.ts",
      "import": "./src/graph/world-publication.ts",
      "default": "./src/graph/world-publication.ts"
    },
    "./world-acoustic": {
      "types": "./src/graph/world-acoustic.ts",
      "import": "./src/graph/world-acoustic.ts",
      "default": "./src/graph/world-acoustic.ts"
    },
    "./world-conversation": {
      "types": "./src/graph/world-conversation.ts",
      "import": "./src/graph/world-conversation.ts",
      "default": "./src/graph/world-conversation.ts"
    },
    "./pinned-review-share": {
      "types": "./src/graph/pinned-review-share.ts",
      "import": "./src/graph/pinned-review-share.ts",
      "default": "./src/graph/pinned-review-share.ts"
    },
    "./review-delivery": {
      "types": "./src/graph/review-delivery.ts",
      "import": "./src/graph/review-delivery.ts",
      "default": "./src/graph/review-delivery.ts"
    },
    "./review-voice-note": {
      "types": "./src/graph/review-voice-note.ts",
      "import": "./src/graph/review-voice-note.ts",
      "default": "./src/graph/review-voice-note.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "typesVersions": {
    "*": {
      "work-session": [
        "src/graph/work-session.ts"
      ],
      "work-session-evidence": [
        "src/graph/work-session-evidence.ts"
      ],
      "world-publication": [
        "src/graph/world-publication.ts"
      ],
      "world-acoustic": [
        "src/graph/world-acoustic.ts"
      ],
      "world-conversation": [
        "src/graph/world-conversation.ts"
      ],
      "pinned-review-share": [
        "src/graph/pinned-review-share.ts"
      ],
      "review-delivery": [
        "src/graph/review-delivery.ts"
      ],
      "review-voice-note": [
        "src/graph/review-voice-note.ts"
      ]
    }
  }
}
