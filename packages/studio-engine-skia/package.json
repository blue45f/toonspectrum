{
  "name": "@toonspectrum/studio-engine-skia",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Skia CanvasKit renderer adapter: SceneIR to raster pixels/PNG, plus the CanvasKit CPU, GPU-island and Graphite/WebGPU provider descriptors.",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./node": {
      "types": "./src/node/index.ts",
      "import": "./src/node/index.ts",
      "default": "./src/node/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@toonspectrum/studio-project-model": "workspace:*",
    "@toonspectrum/studio-engine-registry": "workspace:*",
    "canvaskit-wasm": "0.41.1"
  },
  "devDependencies": {
    "@types/node": "^24"
  }
}
