{
  "name": "@toonspectrum/skia-adapter-v11",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ToonStudio V11 Skia CanvasKit renderer adapter: SceneIR to CPU raster pixels/PNG plus the skia-canvaskit provider descriptor.",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./node": {
      "types": "./src/node/index.ts",
      "import": "./src/node/index.ts",
      "default": "./src/node/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@toonspectrum/project-model-v11": "workspace:*",
    "@toonspectrum/provider-catalog-v11": "workspace:*",
    "canvaskit-wasm": "0.41.1"
  },
  "devDependencies": {
    "@types/node": "^24"
  }
}
