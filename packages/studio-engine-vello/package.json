{
  "name": "@toonspectrum/studio-engine-vello",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ToonStudio V11 Vello CPU provider wrapper over crates/studio-engine-vello wasm (deterministic reference renderer).",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./node": {
      "types": "./src/node/index.ts",
      "import": "./src/node/index.ts",
      "default": "./src/node/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@toonspectrum/studio-project-model": "workspace:*",
    "@toonspectrum/studio-engine-registry": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24"
  }
}
