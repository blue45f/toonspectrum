{
  "name": "@toonspectrum/studio-engine-registry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Engine capability registry, provider descriptors, hybrid execution planner and the renderer-candidate manifest that decide which engine runs each workload.",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./renderer-roles": {
      "types": "./src/renderer-roles.ts",
      "import": "./src/renderer-roles.ts",
      "default": "./src/renderer-roles.ts"
    },
    "./wesl-compile": {
      "types": "./src/wesl-compile.ts",
      "import": "./src/wesl-compile.ts",
      "default": "./src/wesl-compile.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "zod": "^4.4.3",
    "@toonspectrum/studio-project-model": "workspace:*"
  }
}
