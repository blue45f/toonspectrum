# ── DB (PostgreSQL) ──
# 로컬 개발 시에는 .env.local 에 DATABASE_URL 을 정의하세요.
# (예: 로컬 docker Postgres인 경우 postgres://webdex:webdex@127.0.0.1:55432/webdex)
# 원격은 Neon 등 서버리스 Postgres 연결 문자열(sslmode=verify-full). 스키마: pnpm exec drizzle-kit push.
# DB는 동적 데이터 전용(리뷰·커뮤니티·계정·창작 + ingest 실행 이력 수 KB) — 카탈로그는 파일 전용.
DATABASE_URL=
# pg 풀 슬림화(Neon 비용 가드): 유휴 연결을 빨리 닫아 Neon 컴퓨트가 autosuspend 되게 한다.
# WEBDEX_PG_POOL_MAX=3        # 최대 동시 연결(기본 3) — UGC 트래픽엔 충분
# WEBDEX_PG_IDLE_MS=10000     # 유휴 연결 종료(ms, 기본 10000) — 짧을수록 Neon이 빨리 잠든다

# ── 카탈로그 저장(파일 전용) ──
# 카탈로그 운영 소스는 gz 파일(기본 apps/api/data/catalog.json.gz). ingest가 원자적으로 갱신하고
# API는 부팅 로드 + mtime/size 스탯 폴링(CATALOG_REFRESH_POLL_SECONDS)으로 핫 리로드한다 — DB 전송 0.
# WEBDEX_CATALOG_FILE=        # 카탈로그 gz 경로 재정의(읽기/쓰기 공통)
# WEBDEX_CATALOG_GZ=          # 레거시 읽기 별칭. 새 배포는 WEBDEX_CATALOG_FILE을 사용하세요.
# WEBDEX_CATALOG_FORCE_DB=    # (레거시) 1이면 DB catalog_snapshot 읽기/쓰기/DDL 경로로 복귀 —
#                             # Neon 전송 쿼터를 크게 소모하므로 롤백/검증 외에는 사용하지 않는다.
# 데이터 갱신(선택): 폴링 핫 리로드 주기(초, 0=off. 파일 모드=스탯 폴링, FORCE_DB=DB 폴링),
# 보존 스냅샷 개수(레거시 FORCE_DB 모드에서만 사용)
# CATALOG_REFRESH_POLL_SECONDS=60
# CATALOG_SNAPSHOT_RETENTION=5

# ── 실시간 라이브 랭킹 설정(보존된 어댑터용) ──
# 현재 프론트 정적 카탈로그와 Nest /api/ranking 기본 경로는 disableLive=true라 스냅샷 산식만 사용합니다.
# live.ts 어댑터를 별도 운영 경로에서 다시 연결할 때만 아래 값을 켜세요.
WEBTOON_LIVE_REFRESH_MODE=off
# WEBTOON_LIVE_TTL_SECONDS=120
# WEBTOON_LIVE_REFRESH_INTERVAL_SECONDS=120
# WEBTOON_LIVE_REFRESH_BURST_SECONDS=60
# WEBTOON_LIVE_REFRESH_IDLE_SECONDS=600
# adaptive 모드에서 최근 N초 내 요청이 임계치 이상이면 갱신 간격을 burst로 단축
# WEBTOON_LIVE_REFRESH_DEMAND_WINDOW_SECONDS=120
# WEBTOON_LIVE_REFRESH_DEMAND_THRESHOLD=4

# ── 서버 카탈로그 수집(ingest) 설정 ──
# 기본 off: 플랫폼 약관/robots/제휴 범위를 확인한 뒤 명시적으로 fixed로 켭니다.
# 서버는 scripts/crawl.mjs --json --no-file 결과를 검증해 catalog.json.gz 파일로 저장합니다
# (실행 이력만 DB catalog_ingest_run 에 기록 — 수 KB. WEBDEX_CATALOG_FORCE_DB=1 레거시 모드만 DB 스냅샷).
CATALOG_INGEST_MODE=off
CATALOG_INGEST_INTERVAL_SECONDS=1800
# 크롤 하드 타임아웃(기본 600000=10분, 범위 30000~1800000). 크롤러엔 timeout-30s 소프트 예산이 주입되고,
# 하드 타임아웃 도달 시 프로세스는 SIGKILL로 정리됩니다(좀비 방지).
CATALOG_INGEST_TIMEOUT_MS=600000
# stdout 최대 버퍼(MB, 기본 64). 기본 소스셋 크롤 JSON은 수십 MB라 너무 낮추면 maxBuffer 초과로 실패합니다.
CATALOG_INGEST_SCRIPT_MAX_OUTPUT_MB=64
CATALOG_CRAWL_SCRIPT=scripts/crawl.mjs
# 품질 게이트: 직전 스냅샷 대비 총건수가 이 비율 미만으로 급감하거나 주요 소스가 붕괴하면(force 아니면)
# 새 스냅샷 승격을 거부하고 run을 aborted로 기록 → 한 소스 차단 시 조용한 부분 회귀 방지 (0<r<=1)
CATALOG_INGEST_MIN_RETAIN_RATIO=0.6
# POST /api/catalog/ingest/run 수동 실행 토큰(x-catalog-ingest-token 헤더 또는 body token, 앞뒤 공백 무시).
# 미설정이면 토큰 인증 경로는 401로 거부되며, 관리자 세션(x-user-id) 경로로만 수동 실행할 수 있습니다.
# 같은 클라이언트의 호출은 분당 5회로 제한(429), 실행 중 재요청은 409로 거부됩니다.
CATALOG_INGEST_TRIGGER_TOKEN=

# ── 표지 이미지 노출 정책(저작권·청소년보호) ──
# proxy(기본): 허용 호스트 표지를 프록시로 표시. 단 Referer 위조(핫링크 보호 우회)는 하지 않고,
#   성인(만 19세+) 표지는 항상 비노출하며, 출처는 원 플랫폼으로 링크된다.
# off: 제3자 표지를 일절 표시하지 않고 자체 타이포그래픽 커버만 쓴다(최대 안전·즉시 킬스위치).
#   권리침해 신고 대응·최대 보수 운영 시 이 값으로 전환하면 정적/런타임/프록시가 모두 표지를 끈다.
COVER_IMAGE_POLICY=proxy

# ── 크롤러 호출량 제한 ──
# 미설정 시 가능한 범위를 수집하되, 운영에서는 플랫폼별 허용 범위에 맞춰 제한하세요.
# all은 레지스트리 전체를 뜻하지만, 실제 crawler 구현 소스만 실행되고 나머지는 status의 pending에 남습니다.
WEBDEX_SOURCE_IDS=all
WEBDEX_WEBTOON_CAP=
WEBDEX_WEBTOON_DETAIL_CAP=300
WEBDEX_SERIES_BONUS_CAP=
WEBDEX_KAKAO_WEBTOON_CAP=
WEBDEX_LEZHIN_CAP=
WEBDEX_WEBTOON_FINISHED_PAGES=
WEBDEX_SERIES_PAGES_PER_GENRE=
WEBDEX_CRAWL_DELAY_MS=300

# ── Nest 백엔드 (새 API 서버) ──
# NODE_ENV=development
# API_RUNTIME_ROLE=full       # 장기 Socket.IO 전용 호스트만 studio-live
# PORT=4001                  # 호스팅 플랫폼이 주입할 때는 직접 고정하지 않습니다.
NEST_API_URL=http://127.0.0.1:4001
NEST_API_PORT=4001
# API 접근을 허용할 운영 Origin(쉼표 구분). 로컬 Origin은 development에서 자동 허용.
API_CORS_ALLOWED_ORIGINS=
# 운영 예: https://www.toonstudio.cloud,https://toonstudio.cloud
# OG/JSON-LD 정본 hostname(scheme/path 제외). 운영 예: www.toonstudio.cloud
CANONICAL_HOST=

# 인증 요청 제어 경계 (선택)
# 기본값: Upstash가 유효하면 분산 rate-limit 자동 활성 + direct 소켓 IP 사용.
# controlled single-instance fallback에서만 AUTH_DISTRIBUTED_RATE_LIMIT_ENABLED=false를 사용합니다.
AUTH_DISTRIBUTED_RATE_LIMIT_ENABLED=

# 프록시/엣지 경로를 신뢰할 때만 true로 설정.
# AUTH_TRUSTED_PROXY_ENABLED=true
# AUTH_TRUSTED_PROXY_IPS에 실제 ingress hop의 exact IP를 쉼표로 나열(CIDR 미지원).
# AUTH_TRUSTED_CLIENT_IP_HEADER= x-forwarded-for | x-real-ip | x-vercel-forwarded-for | cf-connecting-ip
# AUTH_TRUSTED_PROXY_MAX_FORWARDED_HOPS=8
AUTH_TRUSTED_PROXY_ENABLED=
AUTH_TRUSTED_PROXY_IPS=
AUTH_TRUSTED_CLIENT_IP_HEADER=
AUTH_TRUSTED_PROXY_MAX_FORWARDED_HOPS=

# ── 창작 스튜디오 Socket.IO 클러스터 ──
# 기본 memory는 단일 Nest 프로세스/로컬 개발용입니다. 여러 장기 실행 Nest 인스턴스가 같은 방을
# 공유할 때만 postgres를 선택하세요. Vercel serverless API에는 이 adapter가 장착되지 않습니다.
# STUDIO_LIVE_CLUSTER_ADAPTER=memory
# postgres 모드는 LISTEN을 유지하므로 Neon의 `-pooler`/PgBouncer transaction endpoint가 아니라
# direct PostgreSQL URL이 필요합니다. DATABASE_URL과 별도 전용 풀(2~10개)을 사용합니다.
# query는 sslmode/channel_binding만 중복 없이 허용. 레거시 require/verify-ca도 verify-full로 정규화합니다.
# STUDIO_LIVE_POSTGRES_URL=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=verify-full&channel_binding=require
# STUDIO_LIVE_POSTGRES_POOL_MAX=2
# 소형 binary Socket.IO payload를 attachment table 왕복 없이 NOTIFY에 직접 싣는 롤링 배포
# 스위치입니다. 모든 API 노드가 이 버전을 실행한 뒤에만 true로 바꾸세요.
# STUDIO_LIVE_POSTGRES_INLINE_BINARY_ENABLED=false
# 프론트가 Vercel serverless HTTP API와 별도의 장기 실행 Socket.IO 서버를 사용할 때 지정합니다.
# 빌드에 공개되는 origin 값이며 경로·쿼리·인증정보 없이 https origin만 넣으세요.
# VITE_STUDIO_LIVE_ORIGIN=https://realtime.example.com
#
# 썸네일·webhook·정리·알림·에셋·presence·댓글·화면 공유 시그널링의 목적별 공급자
# 배치는 deploy/backend-capabilities.env.example의 전체 계약을 복사해 명시적으로 활성화하세요.
# 원본 저장·인증·정본 CRDT를 범용 JSON fallback 호스트로 보내지 않습니다.
# QStash cleanup/notification을 사용할 때는 gateway BASE_URL/AUTH_TOKEN과 별도로 공식 REST
# API_BASE_URL, 서버 전용 PUBLISH_TOKEN, 고정 URL Group을 함께 설정해야 합니다.

# ── Studio 기능별 실시간 호스트 입장권(Cloudflare Durable Objects) ──
# 브라우저는 아래 정확한 HTTPS Worker origin이 설정된 경우에만 presence·댓글 갱신 알림·
# 화면공유 signaling을 Cloudflare로 분리합니다. 경로/쿼리/인증정보는 허용하지 않으며
# 미설정/오류 시 기존 Socket.IO/local transport를 그대로 사용합니다.
# VITE_STUDIO_REALTIME_ORIGIN=https://studio-realtime.example.workers.dev
# VITE_STUDIO_REALTIME_PROVIDER_ID=cloudflare-realtime-v1
# false/미설정이면 발급 route 자체를 등록하지 않습니다. true이면 아래 서버 전용 값이
# 하나라도 없거나 비정상일 때 API bootstrap을 중단해 익명·부분 권한으로 열리지 않게 합니다.
STUDIO_REALTIME_TICKET_ENABLED=false
STUDIO_REALTIME_CLOUDFLARE_PROVIDER_ID=cloudflare-realtime-v1
STUDIO_REALTIME_CLOUDFLARE_TICKET_ISSUER=toonspectrum-api
STUDIO_REALTIME_CLOUDFLARE_TICKET_AUDIENCE=toonspectrum-realtime
# Cloudflare Worker의 REALTIME_TICKET_SECRET과 정확히 같은 32바이트 이상 무작위 문자열.
# 서버 전용이며 VITE_ 변수, 프런트 번들, wrangler vars, 로그에 넣지 마세요.
STUDIO_REALTIME_CLOUDFLARE_TICKET_SECRET=
# 입장권 최대 120초, 연결 세션 최대 14400초. 임시 작업실 ACL 만료보다 자동으로 짧아집니다.
STUDIO_REALTIME_CLOUDFLARE_TICKET_TTL_SECONDS=120
STUDIO_REALTIME_CLOUDFLARE_SESSION_TTL_SECONDS=14400

# ── Studio 목적별 비공개 오브젝트 저장소(Supabase Storage) ──
# 원본·파생물·내보내기 결과를 서로 다른 private bucket에 정확한 원본 바이트로 저장합니다.
# 활성화한 배포는 readiness에서 세 버킷의 존재와 public=false를 원격 확인합니다.
# service-role key는 서버 전용이며 VITE_ 변수나 브라우저 번들에 절대 넣지 마세요.
SUPABASE_OBJECT_STORAGE_ENABLED=false
SUPABASE_OBJECT_STORAGE_URL=
SUPABASE_OBJECT_STORAGE_SERVICE_ROLE_KEY=
SUPABASE_OBJECT_STORAGE_SOURCE_BUCKET=studio-source-assets-v1
SUPABASE_OBJECT_STORAGE_DERIVED_BUCKET=studio-derived-assets-v1
SUPABASE_OBJECT_STORAGE_EXPORT_BUCKET=studio-exports-v1
# SUPABASE_OBJECT_STORAGE_TIMEOUT_MS=15000
# SUPABASE_OBJECT_STORAGE_MAXIMUM_ASSET_BYTES=67108864
# SUPABASE_OBJECT_STORAGE_MAXIMUM_CONTROL_METADATA_BYTES=4096
# SUPABASE_OBJECT_STORAGE_MAXIMUM_RESPONSE_BYTES=65536

# ── Studio WebRTC 음성 중계 정책(기본 비활성) ──
# 음성은 TURN 트래픽과 클러스터 검색 비용이 커서 미설정/false이면 서버 참가·신호·검색을 모두
# 차단합니다. 현재 제품 UI에서도 제거되어 있으며, 별도 유료 운영 정책을 확정한 배포에서만 true로
# 명시하세요. 화면 공유·채팅·presence·CRDT 협업에는 영향을 주지 않습니다.
STUDIO_LIVE_VOICE_ENABLED=false
# 활성 배포는 아래 TURN 데이터 플레인을 별도로 운영하고 UDP와 제한망용 TCP/TLS를 모두 넣으세요.
# STUDIO_VOICE_STUN_URLS=stun:voice.example.com:3478
# STUDIO_VOICE_TURN_URLS=turn:voice.example.com:3478?transport=udp,turn:voice.example.com:3478?transport=tcp,turns:voice.example.com:5349?transport=tcp
# coturn `static-auth-secret`과 동일한 32자 이상 비밀. VITE_ 변수나 클라이언트 번들에 넣지 마세요.
# STUDIO_VOICE_TURN_SHARED_SECRET=
# STUDIO_VOICE_TURN_REQUIRED=false
# 300~86400초. 기본 900초이며 브라우저가 만료 전에 자동 갱신·ICE 재협상을 수행합니다.
# STUDIO_VOICE_TURN_TTL_SECONDS=900

# ── 검증된 래스터 CRDT 파일럿 ──
# 두 값을 정확히 같은 배포에서 함께 설정해야 원형 불투명 펜의 콘텐츠 주소형 PNG 타일 게시와
# WebGPU/Canvas2D 검증 replay handoff가 활성화됩니다. 하나라도 없거나 토큰이 다르면 벡터 CRDT만
# 권위 렌더러로 유지됩니다. VITE 값은 빌드 시 공개되는 기능 토큰이며 비밀키가 아닙니다.
# VITE_STUDIO_RASTER_CRDT_AUTO_PUBLICATION=verified-renderer-handoff-v1
# STUDIO_RASTER_ASSET_ADMISSION=verified-renderer-handoff-v1
# 이미지·VRM·3D 배경의 불변 원본 업로드/read-only hydration 파일럿(공개 rollout 토큰, 비밀 아님).
# STUDIO_WORK_ASSET_ADMISSION=enable-immutable-readonly-work-assets-v1

# ── 창작 스튜디오 서버 AI(DeepSeek, 텍스트 전용) ──
# 구도·장면 분할·대사·번역·팔레트 제안에만 사용합니다. 이미지 생성/채색 API가 아니며,
# 키는 VITE_ 접두사를 붙이지 말고 서버 환경변수로만 보관하세요.
DEEPSEEK_API_KEY=
# 사용자 식별자를 제공자에 원문으로 보내지 않기 위한 HMAC salt(32자 이상 권장).
DEEPSEEK_USER_ID_SALT=
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_TIMEOUT_MS=45000
# Z.ai 일반 API(선택). 공식 일반 endpoint만 사용하며 Coding Plan 전용 endpoint로 우회하지 않습니다.
ZAI_API_KEY=
# ZAI_MODEL=glm-5.1
# ZAI_TIMEOUT_MS=45000
# 둘 다 설정했을 때 auto 모드의 시도 순서. 명시적 제공자 선택에는 fallback을 적용하지 않습니다.
# STUDIO_AI_PROVIDER_ORDER=zai,deepseek
# STUDIO_AI_TIMEOUT_MS=45000
# DB 기반 사용자별 UTC 일일 한도(모든 API 인스턴스에 원자 적용). 기본 200회 / 1,000,000토큰.
# STUDIO_AI_DAILY_REQUEST_LIMIT=200
# STUDIO_AI_DAILY_TOKEN_LIMIT=1000000
# 서비스 전체 비용 상한(모든 사용자 합산, UTC 일일). 미설정 기본값: 500회 / 2,000,000 토큰.
# STUDIO_AI_GLOBAL_DAILY_REQUEST_LIMIT=500
# STUDIO_AI_GLOBAL_DAILY_TOKEN_LIMIT=2000000
# DB 확인/원장 커밋 실패 시 공급자 호출 또는 응답 반환을 차단하는 fail-closed 정책입니다.
# 기존 서버 대납 이미지 에셋 생성 기능(선택, DeepSeek와 별개).
CREATOR_IMAGE_AI_ENABLED=false
OPENAI_API_KEY=
# 운세 콘티의 선택형 Gemini 가공기. 미설정/호출 실패 시 결정적 로컬 콘티로 폴백합니다.
# 서버 전용이며 URL, 로그, VITE_ 변수에 넣지 마세요.
GEMINI_API_KEY=

# ── 만화규장각(KMAS) 메타데이터 보강(선택) ──
# 인증키가 없으면 기존 카탈로그만 사용합니다. 인증키를 브라우저에 노출하지 마세요.
KMAS_PRV_KEY=
# KMAS_BASE_URL=https://www.kmas.or.kr
# KMAS_MERGE_ON_ACCESS=1
# KMAS_MERGE_ON_ACCESS_LIMIT=24
# KMAS_MERGE_ON_ACCESS_TTL_MS=300000
# KMAS_LOOKUP_CONCURRENCY=3
# KMAS_LOOKUP_CACHE_TTL_MS=86400000
# KMAS_LIVE_SEARCH=0
# KMAS_CATALOG_SOURCE=snapshot
# KMAS_RESPONSE_ENRICH_LIMIT=12
# KMAS_RESPONSE_IMAGE_LIMIT=96

# ── 관리자 권한 ──
# 쉼표 구분 이메일 (없으면 users.role 값으로만 판단)
ADMIN_EMAILS=

# ── 소셜 로그인 (Google · Kakao · Naver) ──
# Google: GIS(Google Identity Services) ID 토큰 흐름 — CLIENT ID 만 있으면 실연동(클라이언트 시크릿 불필요).
#   client id 가 없으면 Google 로그인은 안전하게 비활성화되며 이메일 로그인은 그대로 동작합니다.
#   콘솔: https://console.cloud.google.com/apis/credentials → OAuth 2.0 클라이언트 ID(웹 애플리케이션)
#     - "승인된 JavaScript 원본"에 실제 프론트의 정확한 scheme/host/port를 각각 등록
#       (예: http://localhost:5173, https://www.toonstudio.cloud)
#     - 별도 API Origin을 쓴다면 같은 프론트 Origin을 API_CORS_ALLOWED_ORIGINS에도 등록
#     - GIS 버튼은 ID 토큰을 발급하고 서버가 google-auth-library verifyIdToken 으로 검증합니다.
#   GOOGLE_OAUTH_CLIENT_SECRET 은 레거시 인가-코드(redirect) 폴백 경로에서만 쓰입니다(선택).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Kakao · Naver: 외부 앱키(REST API key / client id·secret) 발급이 필요해 현재 의도적으로 데모 고정입니다.
#   실연동하려면 아래 키를 채우고 lib/server/oauth.ts 의 DEMO_ONLY_PROVIDERS 에서 해당 제공자를 제거하세요.
#   - Kakao : https://developers.kakao.com → 내 애플리케이션 → 카카오 로그인 → REST API 키 / Redirect URI,
#             동의항목에서 닉네임/프로필이미지/이메일 활성화 (이메일 미동의 시 kakao_<id>@kakao.local 로 대체)
#   - Naver : https://developers.naver.com → 애플리케이션 등록 → Client ID/Secret, 네이버 로그인 콜백 URL
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
NAVER_OAUTH_CLIENT_ID=
NAVER_OAUTH_CLIENT_SECRET=
# OAuth 콜백을 받는 API 베이스 (기본 http://localhost:4001). 콘솔 등록 URI와 일치해야 함(레거시 code-flow 폴백).
OAUTH_REDIRECT_BASE_URL=http://localhost:4001
# 로그인 완료 후 사용자를 돌려보낼 프론트 베이스 (기본 http://localhost:5173)
WEB_APP_BASE_URL=http://localhost:5173
# 운영에서는 두 값을 모두 https://www.toonstudio.cloud 로 설정합니다.
# OAuth state 서명 비밀키(미설정 시 프로세스마다 임의 생성 — 재시작 시 진행 중 로그인만 무효)
AUTH_STATE_SECRET=
# 세션 JWT(HS256) 서명 비밀키. 운영(NODE_ENV=production)에서는 필수 — 미설정 시 토큰 발급이 거부됩니다.
#   (미설정 시 AUTH_STATE_SECRET 을 폴백으로 사용; 개발 환경에서만 약한 기본 비밀 허용)
AUTH_SESSION_SECRET=

# ── DeskCloud 네이티브 통합 (@heejun/deskcloud) ──
# 형제 앱 공통 기능(피드백 설문·"What's new" 체인지로그·인앱 알림)을 공식 npm SDK 의 pk_ 브라우저
# 클라이언트로 연결하고, 화면은 이 앱의 디자인 토큰/컴포넌트로 직접 렌더합니다(네이티브 룩앤필).
#
# 각 desk 는 VITE_<DESK>DESK_URL 을 설정했을 때만 활성화됩니다(미설정이면 비활성 = 앱 무영향,
# 앱의 기존 1차 기능은 그대로 동작). VITE_*_PK 는 publishable 키(pk_…, 브라우저 노출 안전)이며
# 미설정 시 'pk_demo' 로 폴백합니다. 비밀 키(sk_…)는 절대 클라이언트 env 에 넣지 마세요.
#
# 라이브 엔드포인트 예시(주석 처리; 실제 배포된 Desk 의 베이스 URL 로 교체):
#   VITE_SURVEYDESK_URL=https://surveydesk.example.com
#   VITE_CHANGELOGDESK_URL=https://changelogdesk.example.com
#   VITE_NOTIFYDESK_URL=https://notifydesk.example.com
#
# SurveyDesk — 인앱 피드백 설문(별점·NPS·선택지·자유입력). 모든 페이지 우상단 플로팅.
VITE_SURVEYDESK_URL=
# VITE_SURVEYDESK_PK=pk_demo
# ChangelogDesk — "새 소식" 인앱 체인지로그 플로팅 런처(우하단, unread 배지).
VITE_CHANGELOGDESK_URL=
# VITE_CHANGELOGDESK_PK=pk_demo
# NotifyDesk — 인앱 알림 벨/인박스(좌상단, unread 폴링·모두 읽음).
VITE_NOTIFYDESK_URL=
# VITE_NOTIFYDESK_PK=pk_demo

# ── 통합 로그인 (Firebase Auth — deskcloud-fleet-auth) ──
# 헤더 "회원" 진입점이 이메일/비밀번호 + 게스트(익명) 로그인을 제공합니다(기존 세션 로그인과 별개).
# Firebase 웹 apiKey 는 공개 식별자지만(보안은 Auth 규칙 + authorizedDomains), 시크릿 스캔 훅이
# AIza… 패턴을 차단하므로 절대 커밋하지 말고 .env.local(gitignored) + Vercel env 로만 주입하세요.
# 실제 값은 비커밋 보관소(~/.config/deskcloud-firebase.env)에서 복사합니다.
# apiKey/appId 미설정 시 런타임 인증이 비활성화됩니다(빌드/타입은 정상, 친절히 degrade).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
# projectId / authDomain 은 비밀이 아니며 기본값(deskcloud-fleet-auth)이 있어 생략 가능합니다.
# VITE_FIREBASE_PROJECT_ID=deskcloud-fleet-auth
# VITE_FIREBASE_AUTH_DOMAIN=deskcloud-fleet-auth.firebaseapp.com
