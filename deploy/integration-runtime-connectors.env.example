# ToonSpectrum external integration runtime connectors.
# Keep every value in the deployment secret store. Never expose these as VITE_* variables.
# Unconfigured connectors remain visible for dry-run planning but live execution fails closed.

# Work management
NOTION_API_TOKEN=
# Override only after reviewing the Notion API upgrade guide.
NOTION_API_VERSION=2026-03-11
LINEAR_API_TOKEN=
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
# Prefer a scoped access token. The legacy key/token pair remains supported when required.
TRELLO_ACCESS_TOKEN=
TRELLO_API_KEY=
TRELLO_TOKEN=

# Team notifications
SLACK_WEBHOOK_URL=
MICROSOFT_TEAMS_WEBHOOK_URL=

# Design handoff and review meetings
FIGMA_ACCESS_TOKEN=
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# External insight sources
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# Google Books search works without a key at low volume; a key can be supplied for operator quota management.
GOOGLE_BOOKS_API_KEY=

# Durable per-actor live-execution ceiling, reset at 00:00 UTC. Valid range: 1..1000.
INTEGRATION_RUNTIME_DAILY_EXECUTIONS_PER_ACTOR=100
