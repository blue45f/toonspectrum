# ToonSpectrum optional backend capability distribution.
#
# This file is documentation only. Do not commit real endpoints or credentials.
# Core auth/work-save/billing/CRDT metadata always remain on NestJS + authoritative PostgreSQL.

BACKEND_DISTRIBUTION_ENABLED=false
BACKEND_LOCAL_FALLBACK=disabled

# Placement is workload-first. Every list contains only providers with the same complete role.
# Omitted providers from the built-in same-role fallback list are appended deterministically.
BACKEND_THUMBNAIL_PROVIDER_ORDER=cloud-run,fly,railway,cloudtype,render,koyeb
BACKEND_WEBHOOK_PROVIDER_ORDER=cloudflare,aws-lambda,azure-functions,vercel,netlify,deno-deploy,supabase,firebase
BACKEND_CLEANUP_PROVIDER_ORDER=upstash-qstash,cloudflare
BACKEND_NOTIFICATION_PROVIDER_ORDER=upstash-qstash,cloudflare
BACKEND_STUDIO_ASSET_PROVIDER_ORDER=supabase,cloudflare,firebase
BACKEND_THUMBNAIL_ASSET_PROVIDER_ORDER=supabase,cloudflare,firebase
BACKEND_EXPORT_ASSET_PROVIDER_ORDER=supabase,cloudflare,firebase
BACKEND_PRESENCE_PROVIDER_ORDER=cloudflare,supabase,firebase,cloud-run,fly,koyeb,railway,cloudtype,render
BACKEND_COMMENTS_PROVIDER_ORDER=cloudflare,supabase,firebase,cloud-run,fly,koyeb,railway,cloudtype,render
BACKEND_SCREEN_SIGNALING_PROVIDER_ORDER=cloudflare,supabase,firebase,cloud-run,fly,koyeb,railway,cloudtype,render

# Exact-fidelity private object storage. This is a separate data-plane boundary,
# not the generic JSON capability gateway above. The three buckets must already
# exist, be private, and have distinct names. The service-role key is server-only.
SUPABASE_OBJECT_STORAGE_ENABLED=false
SUPABASE_OBJECT_STORAGE_URL=
SUPABASE_OBJECT_STORAGE_SERVICE_ROLE_KEY=
SUPABASE_OBJECT_STORAGE_SOURCE_BUCKET=studio-source-assets-v1
SUPABASE_OBJECT_STORAGE_DERIVED_BUCKET=studio-derived-assets-v1
SUPABASE_OBJECT_STORAGE_EXPORT_BUCKET=studio-exports-v1
SUPABASE_OBJECT_STORAGE_TIMEOUT_MS=15000
SUPABASE_OBJECT_STORAGE_MAXIMUM_ASSET_BYTES=67108864
SUPABASE_OBJECT_STORAGE_MAXIMUM_CONTROL_METADATA_BYTES=4096
SUPABASE_OBJECT_STORAGE_MAXIMUM_RESPONSE_BYTES=65536

# Process-local circuit breaker. Keep limits conservative until a shared usage ledger is enabled.
BACKEND_CIRCUIT_FAILURE_THRESHOLD=3
BACKEND_CIRCUIT_COOLDOWN_MS=60000
BACKEND_GATEWAY_MAX_ATTEMPTS=3

# Each provider remains disabled unless every required value below is present.
# BASE_URL must contain only a secure origin. The executor path is fixed by code.
# MAX_PAYLOAD/RESPONSE apply only to the canonical JSON control envelope (hard ceiling 16 MiB).
# Large artwork stays lossless in object storage and is referenced by immutable ID; never lower
# quality or dimensions to fit a gateway limit.
BACKEND_CLOUDFLARE_ENABLED=false
BACKEND_CLOUDFLARE_BASE_URL=
BACKEND_CLOUDFLARE_AUTH_TOKEN=
BACKEND_CLOUDFLARE_DAILY_REQUEST_BUDGET=
BACKEND_CLOUDFLARE_DAILY_COST_BUDGET=
BACKEND_CLOUDFLARE_MAX_EXECUTION_MS=
BACKEND_CLOUDFLARE_MAX_PAYLOAD_BYTES=
BACKEND_CLOUDFLARE_MAX_RESPONSE_BYTES=
BACKEND_CLOUDFLARE_MAX_CONCURRENCY=

BACKEND_SUPABASE_ENABLED=false
BACKEND_SUPABASE_BASE_URL=
BACKEND_SUPABASE_AUTH_TOKEN=
BACKEND_SUPABASE_DAILY_REQUEST_BUDGET=
BACKEND_SUPABASE_DAILY_COST_BUDGET=
BACKEND_SUPABASE_MAX_EXECUTION_MS=
BACKEND_SUPABASE_MAX_PAYLOAD_BYTES=
BACKEND_SUPABASE_MAX_RESPONSE_BYTES=
BACKEND_SUPABASE_MAX_CONCURRENCY=

BACKEND_FIREBASE_ENABLED=false
BACKEND_FIREBASE_BASE_URL=
BACKEND_FIREBASE_AUTH_TOKEN=
BACKEND_FIREBASE_DAILY_REQUEST_BUDGET=
