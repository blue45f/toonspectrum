# QStash is the durable cleanup/notification producer. BASE_URL is the separately deployed
# ToonSpectrum gateway facade origin; API_BASE_URL is the official QStash REST API origin.
# AUTH_TOKEN authenticates facade admission and must differ from PUBLISH_TOKEN, which can enqueue
# paid messages. URL_GROUP endpoints must verify Upstash-Signature and durably deduplicate jobs.
BACKEND_UPSTASH_QSTASH_ENABLED=false
BACKEND_UPSTASH_QSTASH_BASE_URL=
BACKEND_UPSTASH_QSTASH_AUTH_TOKEN=
BACKEND_UPSTASH_QSTASH_API_BASE_URL=https://qstash.upstash.io
BACKEND_UPSTASH_QSTASH_PUBLISH_TOKEN=
BACKEND_UPSTASH_QSTASH_URL_GROUP=toonspectrum-durable-v1
BACKEND_UPSTASH_QSTASH_TIMEOUT_MS=2500
BACKEND_UPSTASH_QSTASH_DELIVERY_TIMEOUT_SECONDS=30
BACKEND_UPSTASH_QSTASH_RETRIES=3
BACKEND_UPSTASH_QSTASH_MAXIMUM_REQUEST_BYTES=262144
BACKEND_UPSTASH_QSTASH_MAXIMUM_RESPONSE_BYTES=32768
BACKEND_UPSTASH_QSTASH_DAILY_REQUEST_BUDGET=
BACKEND_UPSTASH_QSTASH_DAILY_COST_BUDGET=
BACKEND_UPSTASH_QSTASH_MAX_EXECUTION_MS=
BACKEND_UPSTASH_QSTASH_MAX_PAYLOAD_BYTES=
BACKEND_UPSTASH_QSTASH_MAX_RESPONSE_BYTES=
BACKEND_UPSTASH_QSTASH_MAX_CONCURRENCY=

# Shared coordination ledger. This is deliberately separate from QStash and stores only
# short-lived provider leases, circuit/budget state, and idempotency receipts. It must never
# receive artwork, asset bytes, sessions, comments, or authoritative CRDT operations.
UPSTASH_COORDINATION_ENABLED=false
UPSTASH_COORDINATION_REST_URL=
UPSTASH_COORDINATION_REST_TOKEN=
UPSTASH_COORDINATION_KEY_HASH_SECRET=
UPSTASH_COORDINATION_NAMESPACE=toonspectrum
UPSTASH_COORDINATION_TIMEOUT_MS=2500
UPSTASH_COORDINATION_MAX_REQUEST_BYTES=16384
UPSTASH_COORDINATION_MAX_RESPONSE_BYTES=32768
