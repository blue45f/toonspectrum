# ARCHIVED OPTIONAL FALLBACK. This file is not the production environment inventory. Copy secrets
# through the approved secret manager only; do not copy a broad Vercel/.env.local environment into
# this purpose-scoped container and never commit the resulting .env.

# ── 인프라 ────────────────────────────────────────────────
DOMAIN=api.example.com            # 이 API 서버의 공개 도메인(DNS A 레코드 → VM 공인 IP)
ACME_EMAIL=you@example.com        # Let's Encrypt 알림 메일
POSTGRES_USER=toonspectrum
POSTGRES_PASSWORD=                 # 강력한 랜덤 문자열(예: openssl rand -base64 24)
POSTGRES_DB=toonspectrum

# ── 앱(폴백 목적에 필요한 값만 승인된 secret manager에서 주입) ─
AUTH_STATE_SECRET=                 # OAuth state 서명(미설정 시 프로세스 임시 생성 → 재시작 시 state 무효)
AUTH_SESSION_SECRET=               # 세션 JWT 서명(운영 필수)
API_CORS_ALLOWED_ORIGINS=https://www.toonstudio.cloud,https://toonstudio.cloud
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
KAKAO_REST_API_KEY=                # (선택) 카카오 로그인 — 미설정 시 데모 폴백
KAKAO_CLIENT_SECRET=
NAVER_OAUTH_CLIENT_ID=             # (선택) 네이버 로그인
NAVER_OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=https://www.toonstudio.cloud  # OAuth 콘솔 callback URI와 정확히 일치
WEB_APP_BASE_URL=https://www.toonstudio.cloud  # 인증 후 프론트 리다이렉트 정본
CANONICAL_HOST=www.toonstudio.cloud
ADMIN_EMAILS=                      # 콤마 구분 관리자 이메일

# ── 창작 스튜디오 실시간 클러스터(여러 API 인스턴스일 때만) ──
# 단일 OCI API는 memory 기본값으로 충분하다. 다중 인스턴스에서는 postgres를 선택하고 migration
# 0009를 적용한 LISTEN 가능 direct URL을 사용한다(`pooler`/PgBouncer transaction URL 금지).
# 운영 URL query는 sslmode/channel_binding만 허용하며 sslmode=verify-full을 권장한다.
STUDIO_LIVE_CLUSTER_ADAPTER=memory
STUDIO_LIVE_POSTGRES_URL=
STUDIO_LIVE_POSTGRES_POOL_MAX=2

# ── WebRTC 음성(기본 비활성) ──────────────────────────────
# 음성은 OCI fallback과 무관하게 별도 운영 승인·coturn/managed TURN·forced-relay canary가 필요하다.
# 활성화 전에는 URL/secret을 비우고 required=false로 유지한다.
STUDIO_LIVE_VOICE_ENABLED=false
STUDIO_VOICE_STUN_URLS=
STUDIO_VOICE_TURN_URLS=
STUDIO_VOICE_TURN_SHARED_SECRET=
STUDIO_VOICE_TURN_REQUIRED=false
STUDIO_VOICE_TURN_TTL_SECONDS=900

# ── Postgres 튜닝(선택, 인스턴스 리사이즈 시 상향) ─────────
# 기본값은 ≈6GB VM 기준. 4 OCPU/24GB로 키우면 예: PG_SHARED_BUFFERS=6GB PG_EFFECTIVE_CACHE=16GB
# PG_SHARED_BUFFERS=1GB
# PG_EFFECTIVE_CACHE=3GB
# PG_WORK_MEM=16MB
# PG_MAX_CONN=50

# ── 크롤 cron(crawl-update.sh, 선택) ──────────────────────
NAVER_COOKIE=                      # 19+ 표지 인증 크롤용(성인인증된 세션). 미설정 시 익명 크롤
DISCORD_WEBHOOK_URL=               # 신작/영상화 다이제스트 + 검증 실패 알림
