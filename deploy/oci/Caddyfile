# ARCHIVED OPTIONAL FALLBACK. Caddy terminates HTTPS only after the purpose-scoped OCI origin has
# passed the current auth, migration, readiness and canary gates in docs/OCI-MIGRATION.md.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy api:4001
	header -Server
	# 헬스/디버그용 기본 보안 헤더(앱 측 헤더와 중복돼도 무해).
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
