# Copy to .env, replace every deployment value, and keep the result out of git.
# This stack is intentionally separate from deploy/oci and starts only with --profile turn.

# Pin an official coturn release. Review upstream security releases before changing this tag.
COTURN_IMAGE=coturn/coturn:4.14.0-r0-debian

# Public DNS name on the certificate and its static public IP.
TURN_REALM=voice.example.com
TURN_EXTERNAL_IP=

# Leave empty when the host itself owns the public IP. When the VM is behind 1:1 NAT, set its
# private interface IP so coturn advertises public/private with identical relay port mapping.
TURN_RELAY_IP=

TURN_LISTEN_PORT=3478
TURN_TLS_LISTEN_PORT=5349
TURN_RELAY_MIN_PORT=49160
TURN_RELAY_MAX_PORT=49259

# Conservative defaults for ToonSpectrum's audio-only six-person mesh. Tune from observed
# allocation counts and bandwidth; never use 0 (unlimited) in production.
TURN_USER_QUOTA=12
TURN_TOTAL_QUOTA=100
TURN_MAX_BPS=262144
TURN_BPS_CAPACITY=26214400
TURN_LOG_MIN_LEVEL=warning

# Host paths, relative to this compose file. Generate the current secret with:
#   umask 077; mkdir -p secrets; openssl rand -base64 48 | tr '+/' '-_' | tr -d '=\n' > secrets/static-auth-secret
# Use the exact same value for the Nest API STUDIO_VOICE_TURN_SHARED_SECRET.
TURN_SHARED_SECRET_PATH=./secrets/static-auth-secret

# Normally the same file. During rotation point this to the old secret while the current path
# contains the new one; remove the old file only after the issuance TTL plus a safety margin.
TURN_PREVIOUS_SHARED_SECRET_PATH=./secrets/static-auth-secret

# PEM full chain and unencrypted PEM private key for TURN_REALM. Automate renewal and restart.
TURN_TLS_CERT_PATH=./certs/fullchain.pem
TURN_TLS_KEY_PATH=./certs/privkey.pem
