{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "toonspectrum-web",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-14",
  "workers_dev": true,
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/socket.io",
      "/socket.io/*",
      "/title/*",
      "/market",
      "/market/browse",
      "/market/resource/*",
      "/create/*",
      "/showcase/work/*",
      "/showcase/series/*",
      "/u/*",
      "/author/*",
      "/community/post/*",
      "/community/cafes/*",
      "/pencafe/*",
      "/collaborate/*",
      "/community/promote/*",
      "/ranking",
      "/play",
      "/assets/opencascade.wasm-*.wasm",
      "/assets/studio/cc0-20260906/assets/polyhaven-modular-street-seating/modular_street_seating.glb"
    ]
  },
  "r2_buckets": [
    {
      "binding": "LARGE_ASSETS",
      "bucket_name": "toonspectrum-public-assets",
      "preview_bucket_name": "toonspectrum-public-assets"
    }
  ]
}
