# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules

# testing
/coverage
/test-results/
/batch_generated/
/tests/benchmarks/artifacts/
# Regenerable visual-check renders. The JSON receipts beside them ARE tracked; the PNG sheets are
# 51MB and are rebuilt by their harnesses on demand.
/tests/benchmarks/results/brush-contact-sheet/
/tests/benchmarks/results/brush-corner/
/tests/benchmarks/results/brush-tremor/

# production
/dist
/apps/admin-web/dist/
/apps/api/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*


# Supabase CLI local link/cache metadata (project refs and operator state)
/supabase/.temp/

# typescript
*.tsbuildinfo

# Python bytecode/cache generated by Blender and contract tests
__pycache__/
*.py[cod]
*$py.class

# IDE
/.idea/

# dev/QA artifacts (browser automation, screenshots)
/tmp/
/scratch/
/artifacts/
# Temporary self-patching payload shards belong in CI artifacts or commit history.
/.bootstrap/
/.playwright-mcp/
/*.png

# AI agent local caches and session state (로컬 전용, 절대 커밋 금지)
/.impeccable/
/.claude/

# 저장소 하네스 지침은 사용자 전역 ignore보다 우선해 의도적으로 추적한다.
!/CLAUDE.md
!/**/AGENTS.md
!/.github/copilot-instructions.md
!/.cursor/
/.cursor/*
!/.cursor/rules/
/.cursor/rules/*
!/.cursor/rules/toonspectrum.mdc

# opencode loop/goal 플러그인 상태 및 로컬 의존성 (커맨드·에이전트 정의 및 설정은 추적)
/.opencode/goals/
/.opencode/opencode-loop/
/.opencode/package*.json
/.opencode/bun.lock
/.opencode/.gitignore

# scratch diagnostic / benchmark scripts (로컬 임시 디버깅 전용)
**/__diag*
**/__tmp*

# scratch tsconfigs written by scoped typecheck runs (root tsconfig.json stays tracked)
/tsconfig.scratch*.json
/tsconfig.*-scratch.json
/tsconfig.slice-*.json

# local database (libSQL/SQLite) — unreviewed data remains ignored. Reviewed source metadata is tracked.
/data/*
!/data/related-info.json
!/data/asset-releases/
!/data/asset-releases/**
!/data/studio-assets/
!/data/studio-assets/**
*.db
*.db-journal

# 정적 카탈로그 빌드 산출물 (git 소스는 apps/api/data/catalog.json.gz). pnpm catalog:gen 으로 생성.
/apps/web/public/data/
*.db-wal
*.db-shm

!.env.example
!.env.production.example
# Reviewed, public browser origins only; local files stay ignored.
!.env.production

# coturn runtime material (the tracked deployment scaffold contains placeholders only)
/deploy/coturn/secrets/
/deploy/coturn/certs/

# 로컬 테스트 계정 자격증명(절대 커밋 금지)
test-accounts.local.*
/apps/web/public/sitemap.xml
/apps/web/public/sitemaps/

# Grok Build TUI / AI agent session data (로컬 전용, 절대 커밋 금지)
.grok/

# stray screenshot artifacts at repo root (CDP/playwright scratch captures)
/*.jpeg
/*.jpg

# cargo build artifacts
crates/**/target/

# Local AI assistant sessions & configs
/.continue/
/.omo/


# tsc --generateTrace output (pnpm run typecheck:trace); regenerated, never committed
/.tstrace/

# generated QA reports (keep in CI artifacts, not source control)
/qa-results/
*.tmp
*.bak
*.swp
*.swo
*~

# local package content-addressable store (never commit)
.pnpm-store/

# isolated feedback UI review build output
/dist-feedback-review/

# default HTML report from Playwright CLI --reporter=html
/playwright-report/

# Local P2P browser verification cache
.qa/p2p-vite-cache/

# Local social-login credential vault exports (never commit)
/oauth-production.env
/toonstudio-oauth-production.env

# Generated visual UX audit artifacts
.qa/visual-ux/

# Local engine continuation logs, pixel reports, and screenshots.
.qa/engine-resume/

# Generated Scene3D GPU proof screenshots, logs, and Vite dependency caches.
/.qa/scene3d-output-quality/

# Generated by the desktop-sync TypeScript release build.
/apps/desktop-sync/dist/

# Generated review workflow acceptance evidence; retain locally or as CI artifacts.
/.qa/virtual-studio-review-task-completion/
/.qa/virtual-studio-review-production/
/.qa/virtual-studio-review-resolution/
/.qa/virtual-studio-review-export/

# Generated 3D normalization intermediates
apps/web/public/assets/3d/environments/mcp-free-v1/.work/

# Local and CI QA receipts are generated evidence, never maintained source.
/.qa/
