# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/

# production
/build
/dist
/apps/api/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo

# IDE
/.idea/

# dev/QA artifacts (browser automation, screenshots)
/.playwright-mcp/
/*.png
/tmp/

# local database (libSQL/SQLite) — data/ 내용은 무시하되 크롤 스냅샷은 git 소스로 추적한다.
/data/*
!/data/related-info.json
*.db
*.db-journal

# 정적 카탈로그 빌드 산출물 (git 소스는 apps/api/data/catalog.json.gz). pnpm catalog:gen 으로 생성.
/public/data/
*.db-wal
*.db-shm

!.env.example
!.env.production.example

# coturn runtime material (the tracked deployment scaffold contains placeholders only)
/deploy/coturn/secrets/
/deploy/coturn/certs/

# 로컬 테스트 계정 자격증명(절대 커밋 금지)
test-accounts.local.*
/public/sitemap.xml

# Grok Build TUI / AI agent session data (로컬 전용, 절대 커밋 금지)
.grok/
.grok/**/*

# CDP/playwright scratch screenshots (repo root)
/console-*.jpeg
/web-home-*.jpeg
/web-mobile-*.jpeg
/.playwright-mcp/

# stray screenshot artifacts at repo root
/*.jpeg
/*.jpg
/*.png
