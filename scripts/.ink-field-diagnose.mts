import { appendStudioInkwashFluidPreviewStroke, createStudioInkwashFluidPreviewPlanner, createStudioInkwashFluidSession, depositStudioInkwashFluidStroke, resolveStudioInkwashFluidDisplay } from '../apps/web/src/domains/creator/brush/studio-inkwash-fluid';
const w=400,h=190;
const points=Array.from({length:601},(_,i)=>{const t=i/600;return {x:40+300*t,y:30+100*t-Math.sin(t*Math.PI)*28,pressure:0.55};});
const options={tool:'pen' as const,radius:4,pigmentLoad:1.45,wetnessLoad:0.16,inkColor:{r:0,g:0,b:0},spectralAbsorption:{r:1,g:1,b:1}};
function field(scale:number,phase:'preview'|'commit',n:number){const session=createStudioInkwashFluidSession({width:w*scale,height:h*scale});const samples=points.slice(0,n).map(p=>({...p,x:p.x*scale,y:p.y*scale}));const input={...options,radius:options.radius*scale}; if(phase==='preview')appendStudioInkwashFluidPreviewStroke(session,createStudioInkwashFluidPreviewPlanner(input),samples);else depositStudioInkwashFluidStroke(session,{...input,samples});const pixels=resolveStudioInkwashFluidDisplay(session).rgba;const out=new Float64Array(w*h);for(let y=0;y<h;y++)for(let x=0;x<w;x++){let sum=0;for(let dy=0;dy<scale;dy++)for(let dx=0;dx<scale;dx++)sum+=pixels[((y*scale+dy)*w*scale+x*scale+dx)*4+3]!;out[y*w+x]=sum/(scale*scale);}return out;}
const committed=field(4,'commit',601);const preview4=field(4,'preview',301);const preview2=field(2,'preview',301);let count2=0,count4=0,max2=0,max4=0,area=0;for(let y=8;y<83;y++)for(let x=16;x<166;x++){area++;const i=y*w+x,d2=Math.abs(committed[i]!-preview2[i]!),d4=Math.abs(committed[i]!-preview4[i]!);max2=Math.max(max2,d2);max4=Math.max(max4,d4);if(d2>12)count2++;if(d4>12)count4++;}console.log({area,count2,count4,ratio2:count2/area,ratio4:count4/area,max2,max4});
