{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsBuildInfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    // 웹 feature 컴포넌트(/studio·/create)가 ES2022 런타임 API(Error cause 2-arg 등)를 쓰므로
    // 루트 tsconfig 와 동일하게 esnext lib 를 포함한다(앱인토스 WebView=최신 Chromium).
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    // 루트(웹) tsconfig 와 정렬: cross-app import 한 웹 feature 소스(/studio·/create)는 루트의
    // 느슨한 unused 규칙으로 작성됐다. 토스 빌드가 그 소스를 type-check 하므로 동일하게 끈다
    // (웹 소스를 수정하지 않기 위함 — NO fork). 토스 자체 src 도 ESLint 가 unused 를 잡는다.
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      // 웹과 동일한 "@/…" → 레포 루트 매핑(cross-app import 해소). 루트 tsconfig 의 paths 와 일치.
      "@/*": ["../../*"]
    }
  },
  "include": ["src", "granite.config.ts"]
}
