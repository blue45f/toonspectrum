# 배포된 toonspectrum API 오리진 (WebView는 자체 오리진이 API가 아니므로 필수).
# 웹과 동일한 변수명(VITE_API_BASE)을 쓴다 — 공유 ky 클라이언트(src/infrastructure/api)가 이 값을
# 절대 API 베이스로 푼다. (예전 VITE_API_BASE_URL 은 마이그레이션 호환 폴백으로만 인식된다.)
VITE_API_BASE=https://toonspectrum.vercel.app
# 운영 시 toonspectrum API CORS 허용 목록에 추가 필요:
#   https://toonspectrum.apps.tossmini.com (실서비스)
#   https://toonspectrum.private-apps.tossmini.com (QR 테스트)
