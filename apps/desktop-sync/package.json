{
  "name": "@toonspectrum/desktop-sync",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Conflict-safe local folder and Google Drive, Dropbox, OneDrive sync for ToonStudio.",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "cli": "pnpm run build && node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts"
  },
  "bin": {
    "toonstudio-sync": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@napi-rs/keyring": "1.3.0"
  }
}
