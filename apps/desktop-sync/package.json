{
  "name": "@toonspectrum/desktop-sync-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Cross-platform local-folder scan, journal, and conflict-safe sync planning for ToonStudio.",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "cli": "pnpm run build && node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts"
  },
  "bin": {
    "toonstudio-sync": "./dist/cli.js"
  },
  "files": [
    "dist"
  ]
}
