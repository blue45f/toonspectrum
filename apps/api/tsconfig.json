{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "verbatimModuleSyntax": false,
    "baseUrl": ".",
    "paths": {
      "@toonspectrum/core": [
        "../../packages/core/src/index.ts"
      ],
      "@toonspectrum/core/*": [
        "../../packages/core/src/*"
      ],
      "@toonspectrum/studio-project-model": [
        "../../packages/studio-project-model/src/index.ts"
      ],
      "@toonspectrum/studio-project-model/*": [
        "../../packages/studio-project-model/src/*"
      ],
      "@toonspectrum/studio-format-gateway": [
        "../../packages/studio-format-gateway/src/index.ts"
      ],
      "@toonspectrum/studio-format-gateway/*": [
        "../../packages/studio-format-gateway/src/*"
      ]
    },
    "outDir": "dist",
    "rootDir": "../..",
    "types": [
      "node"
    ],
    "sourceMap": true,
    "noEmitOnError": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.spec.ts"
  ]
}
