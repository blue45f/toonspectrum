{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "verbatimModuleSyntax": false,
    "baseUrl": ".",
    "paths": {
      "@toonspectrum/core": [
        "../../packages/core/src/index.ts"
      ],
      "@toonspectrum/core/*": [
        "../../packages/core/src/*"
      ],
      "@toonspectrum/studio-project-model": [
        "../../packages/studio-project-model/src/index.ts"
      ],
      "@toonspectrum/studio-project-model/*": [
        "../../packages/studio-project-model/src/*"
      ],
      "@toonspectrum/studio-format-gateway": [
        "../../packages/studio-format-gateway/src/index.ts"
      ],
      "@toonspectrum/studio-format-gateway/*": [
        "../../packages/studio-format-gateway/src/*"
      ],
      "@toonspectrum/contracts": [
        "../../packages/contracts/src/index.ts"
      ],
      "@toonspectrum/contracts/*": [
        "../../packages/contracts/src/*"
      ],
      "@toonspectrum/studio-project-model/work-session": [
        "../../packages/studio-project-model/src/graph/work-session.ts"
      ],
      "@toonspectrum/studio-project-model/world-publication": [
        "../../packages/studio-project-model/src/graph/world-publication.ts"
      ],
      "@toonspectrum/studio-project-model/world-acoustic": [
        "../../packages/studio-project-model/src/graph/world-acoustic.ts"
      ],
      "@toonspectrum/studio-project-model/world-conversation": [
        "../../packages/studio-project-model/src/graph/world-conversation.ts"
      ],
      "@toonspectrum/studio-project-model/work-session-evidence": [
        "../../packages/studio-project-model/src/graph/work-session-evidence.ts"
      ],
      "@toonspectrum/studio-project-model/pinned-review-share": [
        "../../packages/studio-project-model/src/graph/pinned-review-share.ts"
      ],
      "@toonspectrum/studio-project-model/review-delivery": [
        "../../packages/studio-project-model/src/graph/review-delivery.ts"
      ],
      "@toonspectrum/studio-project-model/review-voice-note": [
        "../../packages/studio-project-model/src/graph/review-voice-note.ts"
      ]
    },
    "outDir": "dist",
    "rootDir": "../..",
    "types": [
      "node"
    ],
    "sourceMap": true,
    "noEmitOnError": true
  },
  "include": [
    "src/**/*",
    "drizzle.config.ts"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.spec.ts"
  ]
}
