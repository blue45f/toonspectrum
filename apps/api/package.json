{
  "name": "@webtoon-nest/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "node --test ../../scripts/verify-api-runtime-imports.test.mjs ../../scripts/verify-api-calendar-runtime.test.mjs ../../scripts/stage-api-workspace-runtime.test.mjs && tsc -p tsconfig.json && node ../../scripts/stage-api-workspace-runtime.mjs && node ../../scripts/verify-api-runtime-imports.mjs && node ../../scripts/verify-legal-policy-runtime.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "integration:generate-secrets": "node scripts/generate-production-integration-secrets.mjs",
    "start": "node dist/apps/api/src/main.js"
  },
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "@msgpack/msgpack": "^2.8.0",
    "@nestjs/common": "^11.1.24",
    "@nestjs/core": "^11.1.24",
    "@nestjs/platform-express": "^11.1.24",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/websockets": "^11.1.28",
    "@socket.io/postgres-adapter": "^0.5.0",
    "@toonspectrum/core": "workspace:*",
    "@toonspectrum/studio-format-gateway": "workspace:*",
    "@toonspectrum/studio-project-model": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "express": "^4.22.2",
    "google-auth-library": "^10.7.0",
    "image-js": "^1.7.0",
    "js-base64": "^3.9.0",
    "korean-lunar-calendar": "0.4.0",
    "lunar-typescript": "1.8.6",
    "nestjs-pino": "^4.6.1",
    "nestjs-zod": "^5.4.0",
    "pg": "^8.21.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "react": "19.2.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "web-push": "3.6.7",
    "yjs": "^13.6.31",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.2",
    "@types/web-push": "3.6.4",
    "tsx": "^4.22.3",
    "typescript": "~6.0.3"
  }
