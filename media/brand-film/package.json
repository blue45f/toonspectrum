{
  "name": "@toonstudio/brand-film",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion authoring toolchain sharing the reviewed product-tour composition with the website runtime",
  "scripts": {
    "studio": "remotion studio src/index.tsx --public-dir=../../apps/web/public",
    "render": "node render.mjs",
    "render:product-tour": "node render-product-tour.mjs",
    "generate:product-tour-narration": "node generate-product-tour-narration.mjs",
    "verify:product-tour-narration": "node generate-product-tour-narration.mjs --check",
    "generate:product-tour-runtime-audio": "node generate-product-tour-runtime-audio.mjs",
    "verify:product-tour-runtime-audio": "node generate-product-tour-runtime-audio.mjs --check",
    "mix:product-tour": "node mix-product-tour-audio.mjs",
    "verify:product-tour": "node generate-product-tour-narration.mjs --check && node generate-product-tour-runtime-audio.mjs --check && node mix-product-tour-audio.mjs --check",
    "render:technology": "node render-technology.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.514",
    "@toonspectrum/product-tour-film": "file:../../packages/product-tour-film",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.514"
  },
  "devDependencies": {
    "@types/react": "19.0.1",
    "@types/react-dom": "19.0.2",
    "typescript": "5.8.3"
  }
}
